        RowBox[{"eVecsT", " ", "=", " ", 
         RowBox[{"Transpose", "[", "eVecs", "]"}]}], ";", " ", 
        RowBox[{"oVecsT", " ", "=", " ", 
         RowBox[{"Transpose", "[", "oVecs", "]"}]}], ";", "\n", "\n", "    ", 
        
        RowBox[{"(*", " ", 
         RowBox[{
         "Use", " ", "With", " ", "to", " ", "inject", " ", "values", " ", 
