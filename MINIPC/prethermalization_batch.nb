     "\[IndentingNewLine]", 
     RowBox[{"integEVals", "=", 
      RowBox[{"integSetup", "[", "\"\<eVals\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"integOVals", "=", 
      RowBox[{"integSetup", "[", "\"\<oVals\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  Even sector: \>\"", ",", 
