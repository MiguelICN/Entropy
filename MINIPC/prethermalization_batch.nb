      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
        "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
      "*)"}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"PLOT", " ", "2"}], ":", 
       RowBox[{
       "Median", " ", "splitting", " ", "of", " ", "degenerate", " ", "pairs",
         " ", "vs", " ", "h"}]}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{
      "This", " ", "is", " ", "the", " ", "scalar", " ", "that", " ", 
       "should", " ", "track", " ", 
       RowBox[{"1", "/", "T_M"}]}], "*)"}], 
     RowBox[{"(*", " ", 
      RowBox[{
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
        "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
      "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"splitData", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"allResults", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<h\>\"", "]"}], ",", 
            RowBox[{
             RowBox[{"allResults", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<medianSplit\>\"", 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "allResults", "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"medianSplits", "=", "splitData"}], ";", "\[IndentingNewLine]", 
     RowBox[{"plt2", "=", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"ListLogLogPlot", "[", 
         RowBox[{"medianSplits", ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Black", ",", 
             RowBox[{"PointSize", "[", "0.02", "]"}]}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<h (perturbation)\>\"", ",", "14"}], "]"}], ",", 
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<\[Delta]\[Omega] (median splitting)\>\"", ",", 
               "14"}], "]"}]}], "}"}]}], ",", 
          RowBox[{"FrameTicksStyle", "->", "12"}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<L=\>\"", "<>", 
              RowBox[{"ToString", "[", "LL", "]"}], "<>", "\"\<, g=\>\"", "<>", 
              RowBox[{"ToString", "[", "gVal", "]"}], 
              "<>", "\"\< \[LongDash] Degenerate pair splitting\>\""}], ",", 
             "14"}], "]"}]}], ",", 
          RowBox[{"ImageSize", "->", "600"}], ",", 
          RowBox[{"AspectRatio", "->", "0.65"}]}], "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{"Overlay", " ", "reference", " ", "lines"}], "*)"}], 
        RowBox[{"LogLogPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"medianSplits", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "/", 
                RowBox[{"medianSplits", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ")"}], "^", 
              "1"}]}], ",", 
            RowBox[{
             RowBox[{"medianSplits", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "/", 
                RowBox[{"medianSplits", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ")"}], "^", 
              "2"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"Min", "[", "hScan", "]"}], ",", 
            RowBox[{"Max", "[", "hScan", "]"}]}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Blue", ",", "Dashed"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"Red", ",", "Dashed"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"Placed", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                
                RowBox[{"\"\<\[Delta]\[Omega] ~ h\>\"", ",", "12", ",", 
                 "Blue"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                
                RowBox[{"\"\<\[Delta]\[Omega] ~ \
\\!\\(\\*SuperscriptBox[\\(h\\), \\(2\\)]\\)\>\"", ",", "12", ",", "Red"}], 
                "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0.75", ",", "0.3"}], "}"}]}], "]"}]}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "plt1", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "plt2", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Store", " ", "for", " ", "further", " ", "use"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"$gapData", "=", "allResults"}], ";"}]}], "]"}]}]], "Input",
