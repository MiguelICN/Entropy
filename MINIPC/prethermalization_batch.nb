                  RowBox[{"\"\<E\>\"", ",", "\"\<j\>\""}], "]"}], 
                 ",", "\"\<|\>\""}], "}"}], "]"}]}], ",", "14"}], "]"}], ",", 
           
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Probability density\>\"", ",", "14"}], "]"}]}], 
          "}"}]}], ",", 
        RowBox[{"FrameTicksStyle", "->", "12"}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"\"\<L=\>\"", "<>", 
            RowBox[{"ToString", "[", "LL", "]"}], "<>", "\"\<, g=\>\"", "<>", 
            
            RowBox[{"ToString", "[", "gVal", "]"}], "<>", "\"\< (SRN)\>\""}], 
           ",", "14", ",", "Bold"}], "]"}]}], ",", 
        RowBox[{"ImageSize", "->", "800"}], ",", 
        RowBox[{"AspectRatio", "->", "0.5"}]}], "]"}]}], ";", 
