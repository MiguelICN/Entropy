     "\[IndentingNewLine]", 
     RowBox[{"colors", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"cf", "[", 
         RowBox[{"Rescale", "[", 
          RowBox[{
           RowBox[{"Log10", "[", 
            RowBox[{
             RowBox[{"allResults", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<h\>\"", "]"}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"logMin", ",", "logMax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "allResults", "]"}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"plotData", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Log10", "[", 
           RowBox[{
            RowBox[{"allResults", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<allGaps\>\"", "]"}], 
           "]"}], ",", 
          RowBox[{
           RowBox[{"#", ">", 
            RowBox[{"-", "15"}]}], "&"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "allResults", "]"}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"plt1", "=", 
      RowBox[{"Histogram", "[", 
       RowBox[{"plotData", ",", 
        RowBox[{"{", "0.2", "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{"bin", " ", "width", " ", "in", " ", "decades"}], 
         "*)"}], "\"\<Probability\>\"", ",", 
        RowBox[{"ChartStyle", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Directive", "[", 
             RowBox[{"#", ",", 
              RowBox[{"Opacity", "[", "0.4", "]"}], ",", 
              RowBox[{"EdgeForm", "[", "None", "]"}]}], "]"}], "&"}], "/@", 
           "colors"}], ")"}]}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "14"}], ",", "2"}], "}"}], ",", "All"}], "}"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
