            "       ", 
            RowBox[{"wMe", " ", "=", " ", "mMe"}], ",", " ", 
            RowBox[{"wMo", " ", "=", " ", "mMo"}], ",", " ", 
            RowBox[{"wMeT", " ", "=", " ", "mMeT"}], ",", " ", 
