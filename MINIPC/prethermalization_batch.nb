                    RowBox[{"#", ">", "1.*^-14"}], "&"}]}], "]"}], "]"}], ",",
                 "0."}], "]"}]}]}], "|>"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"ih", ",", 
          RowBox[{"Length", "[", "hScan", "]"}]}], "}"}]}], "]"}]}], ";", 
