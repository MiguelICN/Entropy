             RowBox[{"[", "ih", "]"}], "]"}], ",", "\"\<...\>\""}], "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"setup", "=", 
           RowBox[{"setupForHG", "[", 
            RowBox[{"gVal", ",", 
             RowBox[{"hScan", "[", 
              RowBox[{"[", "ih", "]"}], "]"}], ",", "LL"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"eVals", "=", 
           RowBox[{"setup", "[", "\"\<eVals\>\"", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"oVals", "=", 
           RowBox[{"setup", "[", "\"\<oVals\>\"", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"eAll", ",", "eSplit", ",", "nDegE"}], "}"}], "=", 
           RowBox[{"gapSplittingAnalysis", "[", 
            RowBox[{"integEVals", ",", "eVals"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"oAll", ",", "oSplit", ",", "nDegO"}], "}"}], "=", 
           RowBox[{"gapSplittingAnalysis", "[", 
            RowBox[{"integOVals", ",", "oVals"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<h\>\"", "->", 
             RowBox[{"hScan", "[", 
              RowBox[{"[", "ih", "]"}], "]"}]}], ",", 
            RowBox[{"\"\<allGaps\>\"", "->", 
             RowBox[{"Join", "[", 
              RowBox[{"eAll", ",", "oAll"}], "]"}]}], ",", 
            RowBox[{"\"\<degSplittings\>\"", "->", 
             RowBox[{"Join", "[", 
              RowBox[{"eSplit", ",", "oSplit"}], "]"}]}], ",", 
            RowBox[{"\"\<nDegPairs\>\"", "->", 
             RowBox[{"nDegE", "+", "nDegO"}]}], ",", 
            RowBox[{"\"\<medianSplit\>\"", "->", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", 
                 RowBox[{"Join", "[", 
                  RowBox[{"eSplit", ",", "oSplit"}], "]"}], "]"}], ">", "0"}],
                ",", 
               RowBox[{"Median", "[", 
                RowBox[{"Select", "[", 
                 RowBox[{
                  RowBox[{"Join", "[", 
                   RowBox[{"eSplit", ",", "oSplit"}], "]"}], ",", 
                  RowBox[{
                   RowBox[{"#", ">", "1.*^-14"}], "&"}]}], "]"}], "]"}], ",", 
               "0."}], "]"}]}]}], "|>"}]}]}], "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"ih", ",", 
         RowBox[{"Length", "[", "hScan", "]"}]}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
