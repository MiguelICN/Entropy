     RowBox[{"medianSplits", "=", "splitData"}], ";", "\[IndentingNewLine]", 
     RowBox[{"plt2", "=", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"ListLogLogPlot", "[", 
