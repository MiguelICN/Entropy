Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", "5"}]}], 
    RowBox[{"a", ":", " ", 
     RowBox[{
      RowBox[{"SRN", " ", "entropy", " ", 
       RowBox[{"plots", " ", "--"}]}], "-"}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "res", ",", " ", "paramList", ",", " ", "nH", ",", " ", "hMin", ",",
            " ", "hMax", ",", " ", "logMin", ",", " ", "logMax", ",", "\n", 
           "    ", "curves", ",", " ", "colors", ",", " ", "Sp", ",", " ", 
           "plotTitle", ",", " ", "plt"}], "}"}], ",", "\n", "\n", "    ", 
         RowBox[{
          RowBox[{"res", " ", "=", " ", 
           RowBox[{"$SRNdata", "[", 
            RowBox[{"{", 
             RowBox[{"LL", ",", " ", "gFixed"}], "}"}], "]"}]}], ";", "\n", 
          "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"AssociationQ", "[", "res", "]"}]}], ",", " ", 
            RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "\n", "    ", 
          
          RowBox[{"paramList", " ", "=", " ", 
           RowBox[{"Sort", "[", 
            RowBox[{"Keys", "[", "res", "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"nH", " ", "=", " ", 
           RowBox[{"Length", "[", "paramList", "]"}]}], ";", "\n", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"nH", " ", "==", " ", "0"}], ",", " ", 
            RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "\n", "    ", 
          
          RowBox[{"hMin", " ", "=", " ", 
           RowBox[{"Min", "[", "paramList", "]"}]}], ";", " ", 
          RowBox[{"hMax", " ", "=", " ", 
           RowBox[{"Max", "[", "paramList", "]"}]}], ";", "\n", "    ", 
          RowBox[{"logMin", " ", "=", " ", 
           RowBox[{"Log10", "[", "hMin", "]"}]}], ";", " ", 
          RowBox[{"logMax", " ", "=", " ", 
           RowBox[{"Log10", "[", "hMax", "]"}]}], ";", "\n", "    ", 
          RowBox[{"Sp", " ", "=", " ", 
           RowBox[{"$SRNspage", "[", "LL", "]"}]}], ";", "\n", "\n", "    ", 
          RowBox[{"curves", " ", "=", " ", 
           RowBox[{"Table", "[", "\n", "      ", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"tlist", ",", "\n", "        ", 
                RowBox[{"smoothEntropy", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"res", "[", 
                    RowBox[{"paramList", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], 
                   "[", "\"\<meanEntropy\>\"", "]"}], ",", " ", "maWindow"}], 
                 "]"}]}], "}"}], "]"}], ",", "\n", "      ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "nH"}], "}"}]}], "]"}]}], ";", "\n", 
          "\n", "    ", 
          RowBox[{"colors", " ", "=", " ", 
           RowBox[{"Table", "[", "\n", "      ", 
            RowBox[{
             RowBox[{"cf", "[", 
              RowBox[{"Rescale", "[", 
               RowBox[{
                RowBox[{"Log10", "[", 
                 RowBox[{"paramList", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"logMin", ",", " ", "logMax"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}], "]"}], ",", 
             "\n", "      ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "nH"}], "}"}]}], "]"}]}], ";", "\n", 
          "\n", "    ", 
          RowBox[{"plotTitle", " ", "=", " ", 
           RowBox[{"\"\<L=\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "LL", "]"}], " ", "<>", "\n", 
            "      ", "\"\<, g=\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"gFixed", ",", " ", 
               RowBox[{"{", 
                RowBox[{"6", ",", " ", "5"}], "}"}]}], "]"}], "]"}], " ", "<>",
             " ", "\"\< (SRN)\>\""}]}], ";", "\n", "\n", "    ", 
          RowBox[{"plt", " ", "=", " ", 
           RowBox[{"Legended", "[", "\n", "      ", 
            RowBox[{
             RowBox[{"ListLogLinearPlot", "[", 
              RowBox[{"curves", ",", "\n", "        ", 
               RowBox[{"PlotRange", " ", "->", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"tlist", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                    RowBox[{"tlist", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", " ", 
                    RowBox[{"Sp", " ", "+", " ", "0.3"}]}], "}"}]}], "}"}]}], 
               ",", "\n", "        ", 
               RowBox[{"PlotStyle", " ", "->", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Directive", "[", 
                    RowBox[{"#", ",", " ", 
                    RowBox[{"AbsoluteThickness", "[", "1", "]"}]}], "]"}], 
                   " ", "&"}], " ", "/@", " ", "colors"}], ")"}]}], ",", "\n",
                "        ", 
               RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", 
               "        ", 
               RowBox[{"FrameLabel", " ", "->", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{"\"\<Time (t)\>\"", ",", " ", "14"}], "]"}], ",", 
                  "\n", "          ", 
                  RowBox[{"Style", "[", 
                   RowBox[{"\"\<Entropy S(t)\>\"", ",", " ", "14"}], "]"}]}], 
                 "}"}]}], ",", "\n", "        ", 
               RowBox[{"FrameTicksStyle", " ", "->", " ", "12"}], ",", "\n", 
               "        ", 
               RowBox[{"PlotLabel", " ", "->", " ", 
                RowBox[{"Style", "[", 
                 RowBox[{"plotTitle", ",", " ", "14", ",", " ", "Bold"}], 
                 "]"}]}], ",", "\n", "        ", 
               RowBox[{"ImageSize", " ", "->", " ", "700"}], ",", " ", 
               RowBox[{"AspectRatio", " ", "->", " ", "0.55"}], ",", "\n", 
               "        ", 
               RowBox[{"Epilog", " ", "->", " ", 
                RowBox[{"{", "\n", "          ", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"Black", ",", " ", "Dashed", ",", " ", 
                    RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", "\n", 
                    "            ", 
                    RowBox[{"InfiniteLine", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "Sp"}], "}"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",",
                   "\n", "          ", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Darker", "[", "Green", "]"}], ",", " ", "Dashed",
                     ",", " ", 
                    RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", "\n", 
                    "            ", 
                    RowBox[{"InfiniteLine", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{"Log", "[", "2", "]"}]}], "}"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}]}], 
                 "}"}]}]}], "\n", "      ", "]"}], ",", "\n", "      ", 
             RowBox[{"BarLegend", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"cfBar", "[", 
                  RowBox[{"logMin", ",", " ", "logMax"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"logMin", ",", " ", "logMax"}], "}"}]}], "}"}], ",",
                "\n", "        ", 
               RowBox[{"LegendLabel", " ", "->", " ", 
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Field (h)\>\"", ",", " ", "12"}], "]"}]}], ",", 
               "\n", "        ", 
               RowBox[{"LabelStyle", " ", "->", " ", "11"}], ",", "\n", 
               "        ", 
               RowBox[{"\"\<Ticks\>\"", " ", "->", " ", 
                RowBox[{"Table", "[", "\n", "          ", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"v", ",", " ", 
                    RowBox[{"Superscript", "[", 
                    RowBox[{"\"\<10\>\"", ",", " ", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"Round", "[", "v", "]"}], "]"}]}], "]"}]}], "}"}],
                   ",", "\n", "          ", 
                  RowBox[{"{", 
                   RowBox[{"v", ",", " ", 
                    RowBox[{"Ceiling", "[", "logMin", "]"}], ",", " ", 
                    RowBox[{"Floor", "[", "logMax", "]"}]}], "}"}]}], 
                 "]"}]}]}], "]"}]}], "\n", "    ", "]"}]}], ";", "\n", "\n", 
          "    ", 
          RowBox[{"Export", "[", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"$plotDir", ",", "\n", "      ", 
               RowBox[{"\"\<Entropy_L\>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", "LL", "]"}], " ", "<>", "\n", 
                "      ", "\"\<_g\>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{"gFixed", ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"6", ",", " ", "5"}], "}"}]}], "]"}], "]"}], " ", 
                "<>", " ", "\"\<_SRN.png\>\""}]}], "}"}], "]"}], ",", "\n", 
            "      ", "plt", ",", " ", 
            RowBox[{"ImageResolution", " ", "->", " ", "300"}]}], "]"}], 
          ";"}]}], "\n", "  ", "]"}], ";"}], "\n", "  ", ",", " ", 
      RowBox[{"{", 
       RowBox[{"LL", ",", " ", "Llist"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"gFixed", ",", " ", "gSRNlist"}], "}"}]}], "\n", "]"}], ";"}], 
   "\n"}]}]], "Input",ExpressionUUID->"7c2ea92b-1b5f-cd43-a5f4-f6ff5060fbfd"]
