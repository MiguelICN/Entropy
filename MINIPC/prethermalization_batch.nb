         RowBox[{"JJ", " ", "=", " ", "1."}], ",", " ", 
         RowBox[{"ddim", " ", "=", " ", 
          RowBox[{"2", "^", "LL"}]}], ",", " ", 
         RowBox[{"ePrec", " ", "=", " ", "25"}]}], "}"}], ",", "\n", "\n", 
       "  ", 
       RowBox[{
        RowBox[{"Ha", " ", "=", " ", 
         RowBox[{"N", "[", 
