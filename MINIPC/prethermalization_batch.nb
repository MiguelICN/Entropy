Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"RUN", ":", 
     RowBox[{"SRN", " ", "example"}]}], "\[LongDash]", 
    RowBox[{"fix", " ", "g"}], ",", 
    RowBox[{"scan", " ", "h"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"LL", "=", "8"}], ",", 
      RowBox[{"gVal", "=", 
       RowBox[{"N", "[", 
        RowBox[{"1", "/", "GoldenRatio"}], "]"}]}], ",", 
      RowBox[{"JJ", "=", "1."}], ",", "hScan", ",", "integSetup", ",", 
      "integEVals", ",", "integOVals", ",", "allResults", ",", "plotData", ",",
       "splitData", ",", "medianSplits", ",", "logMin", ",", "logMax", ",", 
      "colors", ",", "plt1", ",", "plt2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Parameter", " ", "scan"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"hScan", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"10", "^", "x"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "10"}], ",", 
           RowBox[{"-", "2"}], ",", "0.2"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Step", " ", "1"}], ":", 
       RowBox[{"Diagonalize", " ", "at", " ", "integrability", " ", 
        RowBox[{"(", 
         RowBox[{"h", "=", "0"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", "\"\<Diagonalizing integrable limit (h=0)...\>\"", "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"integSetup", "=", 
      RowBox[{"setupForHG", "[", 
       RowBox[{"0.", ",", "gVal", ",", "LL"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"integEVals", "=", 
      RowBox[{"integSetup", "[", "\"\<eVals\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"integOVals", "=", 
      RowBox[{"integSetup", "[", "\"\<oVals\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  Even sector: \>\"", ",", 
       RowBox[{"Length", "[", "integEVals", "]"}], ",", "\"\< levels, \>\"", ",", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"sectorGaps", "[", "integEVals", "]"}], ",", 
         RowBox[{"x_", "/;", 
          RowBox[{"x", "<", "1.*^-10"}]}]}], "]"}], 
       ",", "\"\< degenerate pairs\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  Odd sector:  \>\"", ",", 
       RowBox[{"Length", "[", "integOVals", "]"}], ",", "\"\< levels, \>\"", ",", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"sectorGaps", "[", "integOVals", "]"}], ",", 
         RowBox[{"x_", "/;", 
          RowBox[{"x", "<", "1.*^-10"}]}]}], "]"}], 
       ",", "\"\< degenerate pairs\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Step", " ", "2"}], ":", 
       RowBox[{"Scan", " ", "perturbation", " ", "strengths"}]}], "*)"}], 
     RowBox[{"allResults", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "setup", ",", "eVals", ",", "oVals", ",", "eAll", ",", "eSplit", ",",
             "oAll", ",", "oSplit", ",", "nDegE", ",", "nDegO"}], "}"}], ",", 
          
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<  h = \>\"", ",", 
             RowBox[{"hScan", "[", 
              RowBox[{"[", "ih", "]"}], "]"}], ",", "\"\<...\>\""}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"setup", "=", 
            RowBox[{"setupForHG", "[", 
             RowBox[{
              RowBox[{"hScan", "[", 
               RowBox[{"[", "ih", "]"}], "]"}], ",", "gVal", ",", "LL"}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"eVals", "=", 
            RowBox[{"setup", "[", "\"\<eVals\>\"", "]"}]}], ";", 
           RowBox[{"oVals", "=", 
            RowBox[{"setup", "[", "\"\<oVals\>\"", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"eAll", ",", "eSplit", ",", "nDegE"}], "}"}], "=", 
            RowBox[{"gapSplittingAnalysis", "[", 
             RowBox[{"integEVals", ",", "eVals"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"oAll", ",", "oSplit", ",", "nDegO"}], "}"}], "=", 
            RowBox[{"gapSplittingAnalysis", "[", 
             RowBox[{"integOVals", ",", "oVals"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<h\>\"", "->", 
              RowBox[{"hScan", "[", 
               RowBox[{"[", "ih", "]"}], "]"}]}], ",", 
             RowBox[{"\"\<allGaps\>\"", "->", 
              RowBox[{"Join", "[", 
               RowBox[{"eAll", ",", "oAll"}], "]"}]}], ",", 
             RowBox[{"\"\<degSplittings\>\"", "->", 
              RowBox[{"Join", "[", 
               RowBox[{"eSplit", ",", "oSplit"}], "]"}]}], ",", 
             RowBox[{"\"\<nDegPairs\>\"", "->", 
              RowBox[{"nDegE", "+", "nDegO"}]}], ",", 
             RowBox[{"\"\<medianSplit\>\"", "->", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"Join", "[", 
