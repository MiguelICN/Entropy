          RowBox[{"x", "<", "1.*^-10"}]}]}], "]"}], 
       ",", "\"\< degenerate pairs\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Step", " ", "2"}], ":", 
       RowBox[{"Scan", " ", "perturbation", " ", "strengths"}]}], "*)"}], 
     RowBox[{"allResults", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
