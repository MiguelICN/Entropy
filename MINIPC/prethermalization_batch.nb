            "hval", ",", " ", "gval", ",", " ", "JJ", ",", " ", "LL", ",", 
             "\n", "    ", 
             RowBox[{"BoundaryConditions", " ", "->", " ", "\"\<Open\>\""}]}],
             "]"}], "]"}], "]"}]}], ";", "\n", "\n", "  ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"evenMap", ",", " ", "oddMap"}], "}"}], " ", "=", " ", 
         RowBox[{"buildMaps", "[", "LL", "]"}]}], ";", "\n", "  ", 
        RowBox[{"Me", " ", "=", " ", 
         RowBox[{"makeExpansionMatrix", "[", 
          RowBox[{"evenMap", ",", " ", "LL", ",", " ", "\"\<even\>\""}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"Mo", " ", "=", " ", 
         RowBox[{"makeExpansionMatrix", "[", 
