        RowBox[{"\"\<LRN\>\"", ",", " ", "LL"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"resultsLRN", " ", "=", " ", 
       RowBox[{"Association", "[", "]"}]}], ";", "\n", "\n", "    ", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"gval", " ", "=", " ", 
          RowBox[{"gLRN", "[", 
           RowBox[{"[", "ig", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<  g=\>\"", ",", " ", "gval", ",", " ", "\"\< (\>\"", ",",
            " ", "ig", ",", " ", "\"\</\>\"", ",", " ", 
           RowBox[{"Length", "[", "gLRN", "]"}], ",", " ", "\"\<)\>\""}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"t0", " ", "=", " ", 
          RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"setup", " ", "=", " ", 
          RowBox[{"setupForHG", "[", 
           RowBox[{"hFixed", ",", " ", "gval", ",", " ", "LL"}], "]"}]}], ";",
          "\[IndentingNewLine]", "\n", "\t", 
         RowBox[{"entropyMatrix", "=", 
          RowBox[{"batchEntropy", "[", 
           RowBox[{"setup", ",", "Nic", ",", "tlist", ",", "LL"}], "]"}]}], ";",
          "\n", "\t", 
         RowBox[{"meanS", "=", 
          RowBox[{"Mean", "[", "entropyMatrix", "]"}]}], ";", "\n", "\t", 
         RowBox[{"entropyMatrix", "=", " ", "."}], ";", "\n", "\t", 
         RowBox[{
          RowBox[{"resultsLRN", "[", "gval", "]"}], "=", 
          RowBox[{"<|", 
           RowBox[{"\"\<meanEntropy\>\"", "->", "meanS"}], "|>"}]}], ";", 
         "\n", "\t", "\[IndentingNewLine]", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
