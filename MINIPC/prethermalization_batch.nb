     RowBox[{
     "Print", "[", "\"\<Diagonalizing integrable limit (h=0)...\>\"", "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"integSetup", "=", 
      RowBox[{"setupForHG", "[", 
