            RowBox[{"wEPrec", " ", "=", " ", "ePrec"}], ",", " ", 
            RowBox[{"wLL", " ", "=", " ", "LL"}], ",", " ", 
            RowBox[{"wDA", " ", "=", " ", "ddA"}], ",", " ", 
            RowBox[{"wDB", " ", "=", " ", "ddB"}], ",", " ", 
            RowBox[{"wNt", " ", "=", " ", "NNt"}]}], "}"}], ",", "\n", "\n", 
