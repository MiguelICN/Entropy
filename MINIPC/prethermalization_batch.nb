        RowBox[{"Log10", 
         RowBox[{"(", "gap", ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"y", "-", "axis"}], "=", "count"}]}], "*)"}], 
     RowBox[{"(*", " ", 
      RowBox[{
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
        "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
      "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"logMin", "=", 
      RowBox[{"Log10", "[", 
