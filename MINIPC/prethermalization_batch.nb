      "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"splitData", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"allResults", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<h\>\"", "]"}], ",", 
