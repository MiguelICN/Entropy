                 RowBox[{"gval", ",", "8"}], "]"}], "]"}], 
               "<>", "\"\<.mx\>\""}]}], "}"}], "]"}], ",", "meanS", 
           ",", "\"\<MX\>\""}], "]"}], ";", "\n", "\n", "      ", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<    \>\"", ",", " ", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", "t0"}], ",", 
             " ", "0.1"}], "]"}], ",", " ", "\"\< s\>\""}], "]"}], ";"}], 
        "\n", "      ", ",", " ", 
        RowBox[{"{", 
