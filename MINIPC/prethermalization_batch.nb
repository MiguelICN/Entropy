        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "allResults", "]"}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"plotData", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
