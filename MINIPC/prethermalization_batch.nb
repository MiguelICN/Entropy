  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"LL", "=", "8"}], ",", 
      RowBox[{"gVal", "=", 
       RowBox[{"N", "[", "GoldenRatio", "]"}]}], ",", 
      RowBox[{"JJ", "=", "1."}], ",", "hScan", ",", "integSetup", ",", 
      "integEVals", ",", "integOVals", ",", "allResults", ",", "plotData", ",",
       "splitData", ",", "medianSplits", ",", "logMin", ",", "logMax", ",", 
      "colors", ",", "plt1", ",", "plt2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Parameter", " ", "scan"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"hScan", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"10", "^", "x"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "10"}], ",", 
           RowBox[{"-", "2"}], ",", "0.2"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Step", " ", "1"}], ":", 
