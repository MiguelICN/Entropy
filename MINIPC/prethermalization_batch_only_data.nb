            RowBox[{"wEPrec", " ", "=", " ", "ePrec"}], ",", " ", 
            RowBox[{"wLL", " ", "=", " ", "LL"}], ",", " ", 
            RowBox[{"wDA", " ", "=", " ", "ddA"}], ",", " ", 
            RowBox[{"wDB", " ", "=", " ", "ddB"}], ",", " ", 
            RowBox[{"wNt", " ", "=", " ", "NNt"}]}], "}"}], ",", "\n", "\n", 
          "      ", 
          RowBox[{"ParallelTable", "[", "\n", "        ", 
           RowBox[{
            RowBox[{"Module", "[", "\n", "          ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "psi0", ",", " ", "psiE", ",", " ", "psiO", ",", " ", "ckE", ",",
                 " ", "ckO", ",", " ", "entropies", ",", "\n", "           ", 
                "iEnd", ",", " ", "tChunk", ",", " ", "nChunk", ",", " ", 
