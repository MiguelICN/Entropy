                    "iStart", " ", "+", " ", "wCSize", " ", "-", " ", "1"}], ",",
                     " ", "wNt"}], "]"}]}], ";", "\n", "            ", 
                  RowBox[{"tChunk", " ", "=", " ", 
                   RowBox[{"wTlist", "[", 
                    RowBox[{"[", 
