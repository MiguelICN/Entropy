                 "]"}]}], ";", "\n", "          ", 
               RowBox[{"psiE", " ", "=", " ", 
                RowBox[{"wMeT", " ", ".", " ", "psi0"}]}], ";", "\n", 
               "          ", 
               RowBox[{"psiO", " ", "=", " ", 
                RowBox[{"wMoT", " ", ".", " ", "psi0"}]}], ";", "\n", 
               "          ", 
               RowBox[{"ckE", " ", "=", " ", 
                RowBox[{
                 RowBox[{"Conjugate", "[", "wEVecs", "]"}], " ", ".", " ", 
