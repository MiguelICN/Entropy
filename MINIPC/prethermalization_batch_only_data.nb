            "       ", 
            RowBox[{"wMe", " ", "=", " ", "mMe"}], ",", " ", 
            RowBox[{"wMo", " ", "=", " ", "mMo"}], ",", " ", 
            RowBox[{"wMeT", " ", "=", " ", "mMeT"}], ",", " ", 
            RowBox[{"wMoT", " ", "=", " ", "mMoT"}], ",", "\n", "       ", 
            RowBox[{"wEVecsT", " ", "=", " ", "eVecsT"}], ",", " ", 
            RowBox[{"wOVecsT", " ", "=", " ", "oVecsT"}], ",", "\n", 
            "       ", 
            RowBox[{"wTlist", " ", "=", " ", "ttlist"}], ",", " ", 
            RowBox[{"wCSize", " ", "=", " ", "cSize"}], ",", " ", 
            RowBox[{"wTThresh", " ", "=", " ", "tThresh"}], ",", "\n", 
