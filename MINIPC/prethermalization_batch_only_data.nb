        RowBox[{"Me", " ", "=", " ", 
         RowBox[{"makeExpansionMatrix", "[", 
          RowBox[{"evenMap", ",", " ", "LL", ",", " ", "\"\<even\>\""}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"Mo", " ", "=", " ", 
