                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "I"}], " ", 
                    RowBox[{"Outer", "[", 
                    RowBox[{"Times", ",", " ", "wOVals", ",", " ", "tChunk"}],
                     "]"}]}], "]"}]}]}], ";"}], ",", "\n", "              ", 
                    RowBox[{
                    RowBox[{"tHP", " ", "=", " ", 
                    RowBox[{"SetPrecision", "[", 
                    RowBox[{"tChunk", ",", " ", "wEPrec"}], "]"}]}], ";", 
                    "\n", "              ", 
                    RowBox[{"phaseE", " ", "=", " ", 
                    RowBox[{"N", "[", 
                    RowBox[{"ckE", " ", "*", " ", 
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "I"}], " ", 
                    RowBox[{"Outer", "[", 
