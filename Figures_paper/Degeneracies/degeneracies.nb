             RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], 
            "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"system", "=", 
          RowBox[{"BlockDiagonalize", "[", 
           RowBox[{"Ha", ",", 
            RowBox[{"Symmetry", "->", "\"\<Parity\>\""}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"eveneigenval", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"system", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
