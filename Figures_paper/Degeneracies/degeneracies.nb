            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}], ",", "L"}], "]"}]}], ";", 
         RowBox[{"Nqp", "=", 
          RowBox[{"Total", "[", 
           RowBox[{"nu", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
         RowBox[{"{", 
          RowBox[{"nu", ",", "Nqp"}], "}"}]}]}], "]"}]}]}], ";"}], 
