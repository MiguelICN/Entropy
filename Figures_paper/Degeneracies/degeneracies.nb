Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1.", " ", "Single"}], "-", 
    RowBox[{"Particle", " ", "Energies"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SingleParticleEnergies", "[", 
      RowBox[{"L_", ",", "h_", ",", 
       RowBox[{"J_", ":", "1.0"}]}], "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"J", "^", "2"}], "+", 
          RowBox[{"h", "^", "2"}], "-", 
          RowBox[{"2", " ", "J", "*", "h", "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"n", "*", 
             RowBox[{"Pi", "/", 
              RowBox[{"(", 
               RowBox[{"L", "+", "1"}], ")"}]}]}], "]"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "L"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "1.", " ", "Create", " ", "a", " ", "caching", " ", "function", " ", 
      "for", " ", "the", " ", 
      RowBox[{"structure", ".", "The"}], " ", "`"}], ":=", 
     RowBox[{
      RowBox[{"name", "[", "L", "]"}], "=", 
      RowBox[{
      "`", " ", "syntax", " ", "tells", " ", "Mathematica", " ", "to", " ", 
       "remember", " ", "the", " ", "result", " ", "forever", " ", "after", " ",
        "the", " ", "first", " ", "time", " ", "it", " ", "calculates", " ", 
       "it", " ", "for", " ", "a", " ", "specific", " ", 
       RowBox[{"L", "."}]}]}]}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"CachedTopology", "[", "L_", "]"}], ":=", 
     RowBox[{
      RowBox[{"CachedTopology", "[", "L", "]"}], "=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"nu", ",", "Nqp"}], "}"}], ",", 
        RowBox[{
         RowBox[{"nu", "=", 
          RowBox[{"Tuples", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}], ",", "L"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Nqp", "=", 
          RowBox[{"Total", "[", 
           RowBox[{"nu", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Highly", " ", "optimized", " ", "matrix"}], "-", 
           RowBox[{"level", " ", "sum"}]}], "*)"}], 
         RowBox[{"{", 
          RowBox[{"nu", ",", "Nqp"}], "}"}]}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "The", " ", "streamlined", " ", "ManyBodySpectrum", " ", 
     "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "ManyBodySpectrum", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ManyBodySpectrum", "[", "eps_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", "nu", ",", "Nqp", ",", "E0", ",", "Elist"}], "}"}], 
       ",", 
       RowBox[{
        RowBox[{"L", "=", 
         RowBox[{"Length", "[", "eps", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Instantly", " ", "recall", " ", "the", " ", "structure", " ", 
          "from", " ", "memory", " ", "instead", " ", "of", " ", "rebuilding",
           " ", "it"}], "*)"}], 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"nu", ",", "Nqp"}], "}"}], "=", 
         RowBox[{"CachedTopology", "[", "L", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"E0", "=", 
         RowBox[{
          RowBox[{"-", "0.5"}], "*", 
          RowBox[{"Total", "[", "eps", "]"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"Elist", "=", 
         RowBox[{"E0", "+", 
          RowBox[{"nu", ".", "eps"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"Elist", ",", "nu", ",", "Nqp"}], "}"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
