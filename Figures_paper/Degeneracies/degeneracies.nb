            RowBox[{"system", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"speca", "=", 
          RowBox[{"Sort", "[", 
