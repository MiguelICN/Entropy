Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"EXACT", " ", "FINITE"}], "-", 
    RowBox[{"SIZE", " ", "SINGLE", " ", "PARTICLE", " ", "ENERGIES", " ", 
     RowBox[{"(", 
      RowBox[{"OBC", " ", "BdG"}], ")"}]}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "ExactSingleParticleEnergies", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ExactSingleParticleEnergies", "[", 
      RowBox[{"L_", ",", "h_", ",", 
       RowBox[{"J_", ":", "1.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"A", ",", "B", ",", "HBdG", ",", "evals", ",", "posEvals"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "1.", " ", "Construct", " ", "the", " ", "L", " ", "x", " ", "L", " ",
          "A", " ", "matrix", " ", 
         RowBox[{"(", 
          RowBox[{"Symmetric", ":", 
           RowBox[{"Hopping", "+", "Field"}]}], ")"}]}], "*)"}], 
       RowBox[{
        RowBox[{"A", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "==", "j"}], ",", 
             RowBox[{"2", " ", "h"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"i", "-", "j"}], "]"}], "==", "1"}], ",", 
               RowBox[{"-", "J"}], ",", "0"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "L"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "L"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "2.", " ", "Construct", " ", "the", " ", "L", " ", "x", " ", "L", " ",
           "B", " ", "matrix", " ", 
          RowBox[{"(", 
           RowBox[{"Anti", "-", 
            RowBox[{"symmetric", ":", "Pairing"}]}], ")"}]}], "*)"}], 
        RowBox[{"B", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"j", "==", 
              RowBox[{"i", "+", "1"}]}], ",", 
             RowBox[{"-", "J"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"i", "==", 
                RowBox[{"j", "+", "1"}]}], ",", "J", ",", "0"}], "]"}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "L"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "L"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "3.", " ", "Build", " ", "the", " ", "2", "L", " ", "x", " ", "2", 
          "L", " ", "BdG", " ", "Block", " ", "Matrix"}], "*)"}], 
        RowBox[{"HBdG", "=", 
         RowBox[{"ArrayFlatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"A", ",", "B"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "B"}], ",", 
              RowBox[{"-", "A"}]}], "}"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"4.", " ", "Numerically", " ", "find", " ", 
          RowBox[{"eigenvalues", ".", 
           RowBox[{"(", 
            RowBox[{"//", 
             RowBox[{
              RowBox[{"N", " ", "forces", " ", "fast", " ", "machine"}], "-", 
              
              RowBox[{"precision", " ", "math"}]}]}], ")"}]}]}], "*)"}], 
        RowBox[{"evals", "=", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"HBdG", "//", "N"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "5.", " ", "Sort", " ", "the", " ", "2", "L", " ", "eigenvalues", " ",
           "and", " ", "take", " ", "only", " ", "the", " ", "top", " ", "L", 
          " ", 
          RowBox[{"(", 
           RowBox[{"the", " ", "positive", " ", "ones"}], ")"}]}], "*)"}], 
        RowBox[{"posEvals", "=", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"Sort", "[", "evals", "]"}], ",", 
           RowBox[{"-", "L"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "posEvals", "]"}], ";"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
