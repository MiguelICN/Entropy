    "2.", " ", "Use", " ", "ParallelTable", " ", "instead", " ", "of", " ", 
     "ParallelDo"}], "+", "SetSharedVariable"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{"data1", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "Ha", ",", "system", ",", "eveneigenval", ",", "oddeigenval", ",", 
          "speca"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Ha", "=", 
          RowBox[{"-", 
           RowBox[{"IsingHamiltonian", "[", 
            RowBox[{"hx", ",", "hz", ",", "J", ",", "L", ",", 
             RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], 
            "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"system", "=", 
          RowBox[{"BlockDiagonalize", "[", 
           RowBox[{"Ha", ",", 
            RowBox[{"Symmetry", "->", "\"\<Parity\>\""}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"eveneigenval", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"system", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"oddeigenval", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"system", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"speca", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"Join", "[", 
            RowBox[{"eveneigenval", ",", "oddeigenval"}], "]"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"hz", ",", 
              RowBox[{"2", "^", "L"}]}], "]"}], ",", "speca"}], "}"}], 
          "]"}]}]}], "]"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"hz", ",", "0", ",", "3", ",", "0.005"}], "}"}], ",", 
