Cell[CellGroupData[{

Cell["Testing higher precision cycle", "Title",
 CellChangeTimes->{{3.970685499507965*^9, 3.9706855039308796`*^9}, {
  3.9706961137129993`*^9, 3.9706961158437243`*^9}, {3.97070238795125*^9, 
  3.970702388427178*^9}},ExpressionUUID->"b37d4b64-37d1-4336-bbe1-\
dd99c5fb9c2b"],

Cell[CellGroupData[{

Cell["Definitions", "Chapter",
 CellChangeTimes->{{3.9714690535577297`*^9, 
  3.971469056183589*^9}},ExpressionUUID->"858ee65b-78d8-431d-bf85-\
a42fce10c352"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "your"}]}], " ", "defs", " ", "kept", " ", "as"}], "-", 
    RowBox[{"is", "--"}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "revIndex", ",", "buildMaps", ",", "haar", ",", "ProjectBlockVector", ",",
       "evolveSector"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"revIndex", "[", 
      RowBox[{"i_", ",", "l_"}], "]"}], ":=", 
     RowBox[{"FromDigits", "[", 
      RowBox[{
       RowBox[{"Reverse", "[", 
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"i", ",", "2", ",", "l"}], "]"}], "]"}], ",", "2"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"buildMaps", "[", "l_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"visited", ",", 
         RowBox[{"evenMap", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"oddMap", "=", 
          RowBox[{"{", "}"}]}], ",", "j"}], "}"}], ",", 
       RowBox[{
        RowBox[{"visited", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"False", ",", 
           RowBox[{"2", "^", "l"}], ",", "SparseArray"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"visited", "[", 
              RowBox[{"[", 
               RowBox[{"idx", "+", "1"}], "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"j", "=", 
              RowBox[{"revIndex", "[", 
               RowBox[{"idx", ",", "l"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"visited", "[", 
               RowBox[{"[", 
                RowBox[{"idx", "+", "1"}], "]"}], "]"}], "=", "True"}], ";", 
             RowBox[{
              RowBox[{"visited", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}], "=", "True"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"idx", "===", "j"}], ",", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"evenMap", ",", 
                 RowBox[{"{", "idx", "}"}]}], "]"}], ",", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"evenMap", ",", 
                  RowBox[{"{", 
                   RowBox[{"idx", ",", "j"}], "}"}]}], "]"}], ";", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"oddMap", ",", 
                  RowBox[{"{", 
                   RowBox[{"idx", ",", "j"}], "}"}]}], "]"}]}]}], "]"}]}]}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"idx", ",", "0", ",", 
            RowBox[{
             RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"evenMap", ",", "oddMap"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"haar", "[", "L_Integer", "]"}], ":=", 
     RowBox[{"Normalize", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"RandomVariate", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", "1"}], "]"}], "]"}], ",", "30"}], "]"}], "+", 
         RowBox[{"I", " ", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{"RandomVariate", "[", 
             RowBox[{"NormalDistribution", "[", 
              RowBox[{"0", ",", "1"}], "]"}], "]"}], ",", "30"}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"2", "^", "L"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ProjectBlockVector", "[", 
      RowBox[{"state_", ",", "map_", ",", "type_", ",", "l_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"res", ",", 
         RowBox[{"k", "=", "1"}], ",", "a", ",", "b"}], "}"}], ",", 
       RowBox[{
        RowBox[{"res", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"Length", "[", "map", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "pair", "]"}], "==", "1"}], ",", 
             RowBox[{
              RowBox[{"res", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "=", 
              RowBox[{"state", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"pair", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], "]"}], "]"}]}], 
             ",", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"a", ",", "b"}], "}"}], "=", "pair"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"res", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "=", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"type", "===", "\"\<even\>\""}], ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"state", "[", 
                    RowBox[{"[", 
                    RowBox[{"a", "+", "1"}], "]"}], "]"}], "+", 
                    RowBox[{"state", "[", 
                    RowBox[{"[", 
                    RowBox[{"b", "+", "1"}], "]"}], "]"}]}], ")"}], "/", 
                  RowBox[{"Sqrt", "[", "2", "]"}]}], ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"state", "[", 
                    RowBox[{"[", 
                    RowBox[{"a", "+", "1"}], "]"}], "]"}], "-", 
                    RowBox[{"state", "[", 
                    RowBox[{"[", 
                    RowBox[{"b", "+", "1"}], "]"}], "]"}]}], ")"}], "/", 
                  RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}]}]}]}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"k", "++"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"pair", ",", "map"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "res"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"evolveSector", "[", 
      RowBox[{"evec_", ",", "eval_", ",", "state_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ck", "=", 
         RowBox[{
          RowBox[{"Conjugate", "[", "evec", "]"}], ".", "state"}]}], "}"}], ",", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ck", "*", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", "eval", "*", "t"}], "]"}]}], ")"}], "*",
          "evec"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pageEntropy", "[", 
      RowBox[{"La_", ",", "Lb_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"PolyGamma", "[", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "^", "La"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"2", "^", "Lb"}], ")"}]}], "+", "1"}]}], "]"}], "-", 
      RowBox[{"PolyGamma", "[", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "^", "Lb"}], ")"}], "+", "1"}]}], "]"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "^", "La"}], ")"}], "-", "1"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", 
