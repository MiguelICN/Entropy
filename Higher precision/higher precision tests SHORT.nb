Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "parameters"}]}], "/", "data"}], " ", 
     RowBox[{"shared", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"evenMap", ",", "oddMap"}], "}"}], "=", 
     RowBox[{"buildMaps", "[", "L", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"J", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{"1", ",", "30"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"g", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{"1", ",", "30"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tlist", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"10", "^", "\[Tau]"}], ",", "30"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Tau]", ",", 
         RowBox[{"-", "2"}], ",", "22", ",", "0.0020"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hlist", "=", 
     RowBox[{"Reverse", "@", 
      RowBox[{"Sort", "@", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"SetPrecision", "[", 
            RowBox[{
             RowBox[{"10", "^", "x"}], ",", "30"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "8"}], ",", "0", ",", "0.5"}], "}"}]}], "]"}], ",", 
         "0"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"BlockRandom", "[", 
     RowBox[{"SeedRandom", "[", "1234", "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"state", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"haar", "[", 
          RowBox[{"L", "/", "2"}], "]"}], ",", 
         RowBox[{"haar", "[", 
          RowBox[{"L", "/", "2"}], "]"}]}], "]"}], ",", "1"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dims", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{"L", "/", "2"}], ")"}]}], ",", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{"L", "/", "2"}], ")"}]}]}], "}"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.970712226873209*^9, 3.970712228445119*^9}, {
   3.970712308900505*^9, 3.9707123090120287`*^9}, {3.970716092170107*^9, 
   3.970716105439502*^9}, {3.970716143285962*^9, 3.970716160993814*^9}, {
   3.9707162827495613`*^9, 3.9707163033161583`*^9}, {3.971140296948536*^9, 
   3.9711402971996326`*^9}, {3.971141344576819*^9, 3.971141346494506*^9}, {
   3.971141421719103*^9, 3.971141461024474*^9}, {3.9711415597673283`*^9, 
   3.971141571703134*^9}, {3.9711565297193727`*^9, 3.9711565301110764`*^9}, 
   3.971298017692925*^9, {3.971298054049835*^9, 3.97129808385217*^9}, {
   3.9713307570656853`*^9, 3.971330757116969*^9}, {3.971330808311318*^9, 
   3.9713308085351458`*^9}, {3.97146921861611*^9, 
   3.971469218857111*^9}},ExpressionUUID->"d6759cbd-a069-4ad2-8fb9-\
aadbea500669"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "loop"}]}], " ", "over", " ", "hlist", " ", "on", " ", 
     "the", " ", "master"}], ";", 
    RowBox[{
     RowBox[{"parallelize", " ", "only", " ", "inner", " ", 
      RowBox[{"maps", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"h", "=", 
            RowBox[{"hlist", "[", 
             RowBox[{"[", "q", "]"}], "]"}]}], ",", "Ha", ",", "eigenval", ",",
            "eigenvec", ",", "ord", ",", "evolution", ",", "schmidts", ",", 
           "entropy"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Ha", "=", 
           RowBox[{"IsingHamiltonian", "[", 
            RowBox[{"g", ",", "h", ",", "J", ",", "L", ",", 
             RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"eigenval", ",", "eigenvec"}], "}"}], "=", 
           RowBox[{"Quiet", "[", 
            RowBox[{"Eigensystem", "[", "Ha", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ord", "=", 
           RowBox[{"Ordering", "[", "eigenval", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"eigenval", "=", 
           RowBox[{"eigenval", "[", 
            RowBox[{"[", "ord", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"eigenvec", "=", 
           RowBox[{"eigenvec", "[", 
            RowBox[{"[", "ord", "]"}], "]"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Orthogonalize", "[", "eigenvec", "]"}], " ", "if", " ", 
            "needed"}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
             RowBox[{"ship", "*", "numerical", "*", "arrays"}], "+", 
             "helper"}], "\[GreaterEqual]", "only"}], "*)"}], 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "evolveSector", ",", "eigenvec", ",", "eigenval", ",", "state"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"evolution", "=", 
           RowBox[{"ParallelMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"evolveSector", "[", 
               RowBox[{"eigenvec", ",", "eigenval", ",", "state", ",", "#"}], 
               "]"}], "&"}], ",", "tlist"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"schmidts", "=", 
           RowBox[{"ParallelMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"SingularValueList", "[", 
               RowBox[{
                RowBox[{"ArrayReshape", "[", 
                 RowBox[{"#", ",", "dims"}], "]"}], ",", 
                RowBox[{"Tolerance", "->", "0"}]}], "]"}], "&"}], ",", 
             RowBox[{"Chop", "[", 
              RowBox[{"evolution", ",", 
               RowBox[{"10", "^", 
                RowBox[{"(", 
                 RowBox[{"-", "23"}], ")"}]}]}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"entropy", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"#", "==", "0"}], ",", "0", ",", 
                  RowBox[{
                   RowBox[{"-", "#"}], " ", 
                   RowBox[{"Log", "[", "#", "]"}]}]}], "]"}], "&"}], "/@", 
               RowBox[{"(", 
                RowBox[{"i", "^", "2"}], ")"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "schmidts"}], "}"}]}], "]"}]}]}]}], "]"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"q", ",", 
         RowBox[{"Length", "[", "hlist", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"\"\<entanglement_high_precision_L_\>\"", "<>", 
      RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<_J_h_1_LRN.m\>\""}], ",",
      "data"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.970711531096574*^9, 3.970711601047585*^9}, {
   3.970712202326676*^9, 3.970712208571538*^9}, {3.970712246208332*^9, 
   3.97071226431811*^9}, {3.970714321463634*^9, 3.970714347953249*^9}, 
   3.970716080505143*^9, {3.971230025101149*^9, 3.9712300370188932`*^9}, {
   3.9712300921428328`*^9, 3.971230101371585*^9}, 3.9712980306677713`*^9, {
   3.971298090733883*^9, 3.9712980990479403`*^9}, {3.971469225161916*^9, 
   3.9714692354323387`*^9}},ExpressionUUID->"f9804514-5eb8-49f9-a911-\
d18ed2807783"]
}, Open  ]]
}, Open  ]]
