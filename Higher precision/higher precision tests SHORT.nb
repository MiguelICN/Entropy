Cell[BoxData[{
 RowBox[{
  RowBox[{"BlockRandom", "[", 
   RowBox[{"SeedRandom", "[", "1234", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"state", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"haar", "[", 
        RowBox[{"L", "/", "2"}], "]"}], ",", 
       RowBox[{"haar", "[", 
        RowBox[{"L", "/", "2"}], "]"}]}], "]"}], ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dims", "=", 
   RowBox[{"{", 
