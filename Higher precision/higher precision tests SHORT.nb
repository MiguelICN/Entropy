Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "loop"}]}], " ", "over", " ", "hlist", " ", "on", " ", 
     "the", " ", "master"}], ";", 
    RowBox[{
     RowBox[{"parallelize", " ", "only", " ", "inner", " ", 
      RowBox[{"maps", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"h", "=", 
            RowBox[{"hlist", "[", 
             RowBox[{"[", "q", "]"}], "]"}]}], ",", "Ha", ",", "eigenval", ",",
            "eigenvec", ",", "ord", ",", "evolution", ",", "schmidts", ",", 
           "entropy"}], "}"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Ha", "=", 
           RowBox[{"IsingHamiltonian", "[", 
            RowBox[{"g", ",", "h", ",", "J", ",", "L", ",", 
             RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"eigenval", ",", "eigenvec"}], "}"}], "=", 
           RowBox[{"Quiet", "[", 
            RowBox[{"Eigensystem", "[", "Ha", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ord", "=", 
           RowBox[{"Ordering", "[", "eigenval", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"eigenval", "=", 
           RowBox[{"eigenval", "[", 
            RowBox[{"[", "ord", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"eigenvec", "=", 
           RowBox[{"eigenvec", "[", 
            RowBox[{"[", "ord", "]"}], "]"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Orthogonalize", "[", "eigenvec", "]"}], " ", "if", " ", 
            "needed"}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
             RowBox[{"ship", "*", "numerical", "*", "arrays"}], "+", 
             "helper"}], "\[GreaterEqual]", "only"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "evolveSector", ",", "eigenvec", ",", "eigenval", ",", "state"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"evolution", "=", 
           RowBox[{"ParallelMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"evolveSector", "[", 
               RowBox[{"eigenvec", ",", "eigenval", ",", "state", ",", "#"}], 
               "]"}], "&"}], ",", "tlist"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"schmidts", "=", 
           RowBox[{"ParallelMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"SingularValueList", "[", 
               RowBox[{
                RowBox[{"ArrayReshape", "[", 
                 RowBox[{"#", ",", "dims"}], "]"}], ",", 
                RowBox[{"Tolerance", "->", "0"}]}], "]"}], "&"}], ",", 
             RowBox[{"Chop", "[", 
              RowBox[{"evolution", ",", 
               RowBox[{"10", "^", 
                RowBox[{"(", 
                 RowBox[{"-", "23"}], ")"}]}]}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"entropy", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"#", "==", "0"}], ",", "0", ",", 
                  RowBox[{
                   RowBox[{"-", "#"}], " ", 
                   RowBox[{"Log", "[", "#", "]"}]}]}], "]"}], "&"}], "/@", 
               RowBox[{"(", 
                RowBox[{"i", "^", "2"}], ")"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "schmidts"}], "}"}]}], "]"}]}]}]}], "]"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"q", ",", 
         RowBox[{"Length", "[", "hlist", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"\"\<entanglement_high_precision_L_\>\"", "<>", 
      RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<_J_h_1_LRN.m\>\""}], ",",
      "data"}], "]"}]}]}]], "Input",
