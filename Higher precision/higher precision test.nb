Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"2.", " ", "HELPERS"}], 
   "                                                         ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "Hamiltonian"}]}], " ", "setup", " ", "with", " ", 
     "precision", " ", 
     RowBox[{"tracking", " ", "--"}]}], "-"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"setupForHG$HP", "[", 
     RowBox[{"hval_", ",", " ", "gval_", ",", " ", "LL_", ",", " ", "wp_"}], 
     "]"}], " ", ":=", "\n", "  ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "Ha", ",", " ", "Heven", ",", " ", "Hodd", ",", "\n", "    ", 
        "evenEigvals", ",", " ", "evenEigvecs", ",", " ", "oddEigvals", ",", 
        " ", "oddEigvecs", ",", "\n", "    ", "evenMap", ",", " ", "oddMap", ",",
         " ", "Me", ",", " ", "Mo", ",", " ", "p"}], "}"}], ",", "\n", "\n", 
      "    ", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<  Building H...\>\"", "]"}], ";", "\n", 
       "    ", 
       RowBox[{"Ha", " ", "=", " ", 
        RowBox[{"IsingHamiltonianExact", "[", "\n", "      ", 
         RowBox[{
          RowBox[{"SetPrecision", "[", 
           RowBox[{"hval", ",", " ", "wp"}], "]"}], ",", " ", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{"gval", ",", " ", "wp"}], "]"}], ",", "\n", "      ", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{"1", ",", " ", "wp"}], "]"}], ",", " ", "LL", ",", "\n", 
          "      ", 
          RowBox[{"BoundaryConditions", " ", "->", " ", "\"\<Open\>\""}]}], 
         "]"}]}], ";", "\n", "    ", 
       RowBox[{"ReportPrecision", "[", 
        RowBox[{"\"\<Hamiltonian (exact)\>\"", ",", " ", "Ha"}], "]"}], ";", 
       "\n", "\n", "    ", 
       RowBox[{"Print", "[", "\"\<  Sector projection...\>\"", "]"}], ";", 
       "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Heven", ",", " ", "Hodd"}], "}"}], " ", "=", " ", 
        RowBox[{"SectorHamiltoniansHP", "[", 
         RowBox[{"Ha", ",", " ", "LL", ",", " ", "wp"}], "]"}]}], ";", "\n", 
       "    ", 
       RowBox[{"ReportPrecision", "[", 
        RowBox[{"\"\<Heven\>\"", ",", " ", "Heven"}], "]"}], ";", "\n", 
       "    ", 
       RowBox[{"ReportPrecision", "[", 
        RowBox[{"\"\<Hodd\>\"", ",", " ", "Hodd"}], "]"}], ";", "\n", "\n", 
       "    ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  Diagonalizing even sector (dim=\>\"", ",", "\n", 
         "      ", 
         RowBox[{"Length", "[", "Heven", "]"}], ",", " ", "\"\<)...\>\""}], 
        "]"}], ";", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"evenEigvals", ",", " ", "evenEigvecs"}], "}"}], " ", "=", 
        " ", 
        RowBox[{"DiagonalizeSectorHP", "[", 
         RowBox[{"Heven", ",", " ", "wp"}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"ReportPrecision", "[", 
         RowBox[{"\"\<Even eigenvalues\>\"", ",", " ", "evenEigvals"}], 
         "]"}]}], ";", "\n", "    ", 
       RowBox[{"ReportPrecision", "[", 
        RowBox[{"\"\<Even eigenvectors\>\"", ",", " ", "evenEigvecs"}], "]"}],
        ";", "\n", "\n", "    ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  Diagonalizing odd sector (dim=\>\"", ",", "\n", 
         "      ", 
         RowBox[{"Length", "[", "Hodd", "]"}], ",", " ", "\"\<)...\>\""}], 
        "]"}], ";", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"oddEigvals", ",", " ", "oddEigvecs"}], "}"}], " ", "=", " ", 
        RowBox[{"DiagonalizeSectorHP", "[", 
         RowBox[{"Hodd", ",", " ", "wp"}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"ReportPrecision", "[", 
         RowBox[{"\"\<Odd eigenvalues\>\"", ",", " ", "oddEigvals"}], "]"}]}],
        ";", "\n", "    ", 
       RowBox[{"ReportPrecision", "[", 
        RowBox[{"\"\<Odd eigenvectors\>\"", ",", " ", "oddEigvecs"}], "]"}], ";",
        "\n", "\n", "    ", 
       RowBox[{"(*", " ", 
        RowBox[{"Orthonormality", " ", "check"}], " ", "*)"}], "\n", "    ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"GE", ",", " ", "errE"}], "}"}], ",", "\n", "      ", 
         RowBox[{
          RowBox[{"GE", " ", "=", " ", 
           RowBox[{"evenEigvecs", " ", ".", " ", 
            RowBox[{"ConjugateTranspose", "[", "evenEigvecs", "]"}]}]}], ";", 
          "\n", "      ", 
          RowBox[{"errE", " ", "=", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"GE", " ", "-", " ", 
              RowBox[{"IdentityMatrix", "[", 
               RowBox[{"Length", "[", "evenEigvals", "]"}], "]"}]}], "]"}], 
            "]"}]}], ";", "\n", "      ", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<  Orthonormality error (even): \>\"", ",", "\n", 
            "        ", 
            RowBox[{"ScientificForm", "[", 
             RowBox[{"errE", ",", " ", "3"}], "]"}], ",", "\n", "        ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"errE", " ", "<", " ", 
               RowBox[{"10", "^", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "wp"}], " ", "+", " ", "5"}], ")"}]}]}], ",", 
              " ", "\"\< [OK]\>\"", ",", " ", "\"\< [WARNING]\>\""}], "]"}]}],
            "]"}], ";"}]}], "\n", "    ", "]"}], ";", "\n", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"evenMap", ",", " ", "oddMap"}], "}"}], " ", "=", " ", 
        RowBox[{"buildMaps", "[", "LL", "]"}]}], ";", "\n", "\n", "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<eVals\>\"", " ", "->", " ", "evenEigvals"}], ",", " ", 
         RowBox[{"\"\<eVecs\>\"", " ", "->", " ", "evenEigvecs"}], ",", "\n", 
         "      ", 
         RowBox[{"\"\<oVals\>\"", " ", "->", " ", "oddEigvals"}], ",", "  ", 
         RowBox[{"\"\<oVecs\>\"", " ", "->", " ", "oddEigvecs"}], ",", "\n", 
         "      ", 
         RowBox[{"\"\<evenMap\>\"", " ", "->", " ", "evenMap"}], ",", " ", 
         RowBox[{"\"\<oddMap\>\"", " ", "->", " ", "oddMap"}]}], "|>"}]}]}], 
     "\n", "  ", "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"3cd54117-8913-4140-90ae-5c5085e33248"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", "Single"}]}], "-", 
    RowBox[{
    "IC", " ", "entropy", " ", "computation", " ", "with", " ", 
     "parallelized", " ", "time", " ", 
     RowBox[{"chunks", " ", "--"}]}], "-"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"computeEntropyHP", "[", 
      RowBox[{
      "setup_Association", ",", " ", "ttlist_", ",", " ", "LL_", ",", " ", 
       "wp_", ",", " ", 
       RowBox[{"seed_", ":", " ", "1234"}]}], "]"}], " ", ":=", "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "evenMap", ",", " ", "oddMap", ",", " ", "Me", ",", " ", "Mo", ",", 
         "\n", "    ", "psi0", ",", " ", "psiE", ",", " ", "psiO", ",", " ", 
         "ckE", ",", " ", "ckO", ",", "\n", "    ", 
         RowBox[{"dA", " ", "=", " ", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{"LL", "/", "2"}], ")"}]}]}], ",", " ", 
         RowBox[{"dB", " ", "=", " ", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{"LL", "/", "2"}], ")"}]}]}], ",", "\n", "    ", "Nt", ",",
          " ", "cSize", ",", " ", "nChunks", ",", " ", "chunkRanges", ",", 
         " ", "results"}], "}"}], ",", "\n", "\n", "    ", 
       RowBox[{
        RowBox[{"evenMap", " ", "=", " ", 
         RowBox[{"setup", "[", "\"\<evenMap\>\"", "]"}]}], ";", " ", 
        RowBox[{"oddMap", " ", "=", " ", 
         RowBox[{"setup", "[", "\"\<oddMap\>\"", "]"}]}], ";", "\n", "    ", 
        RowBox[{"Me", " ", "=", " ", 
         RowBox[{"makeExpansionMatrixExact", "[", 
          RowBox[{"evenMap", ",", " ", "LL", ",", " ", "\"\<even\>\""}], 
          "]"}]}], ";", "\n", "    ", 
        RowBox[{"Mo", " ", "=", " ", 
         RowBox[{"makeExpansionMatrixExact", "[", 
          RowBox[{"oddMap", ",", " ", "LL", ",", " ", "\"\<odd\>\""}], 
          "]"}]}], ";", "\n", "\n", "    ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Generate", " ", "initial", " ", "state", " ", "at", " ", 
          "controlled", " ", "precision"}], " ", "*)"}], "\n", "    ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{"SeedRandom", "[", "seed", "]"}], "]"}], ";", "\n", "    ", 
        RowBox[{"psi0", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"KroneckerProduct", "[", "\n", "      ", 
            RowBox[{
             RowBox[{"HaarStateHP", "[", 
              RowBox[{"dA", ",", " ", "wp"}], "]"}], ",", " ", 
             RowBox[{"HaarStateHP", "[", 
              RowBox[{"dB", ",", " ", "wp"}], "]"}]}], "]"}], ",", " ", "1"}],
           "]"}]}], ";", "\n", "    ", 
        RowBox[{"ReportPrecision", "[", 
         RowBox[{"\"\<Initial state\>\"", ",", " ", "psi0"}], "]"}], ";", 
        "\n", "\n", "    ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"Verify", " ", "S", 
           RowBox[{"(", 
            RowBox[{"t", "=", "0"}], ")"}]}], " ", "=", " ", "0"}], " ", 
         "*)"}], "\n", "    ", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "s0", "}"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"s0", " ", "=", " ", 
            RowBox[{"EntanglementEntropySVDHP", "[", 
             RowBox[{"psi0", ",", " ", "dA", ",", " ", "dB", ",", " ", "wp"}],
              "]"}]}], ";", "\n", "      ", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<  S(t=0) = \>\"", ",", " ", 
             RowBox[{"ScientificForm", "[", 
              RowBox[{"s0", ",", " ", "3"}], "]"}], ",", "\n", "        ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", "s0", "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "wp"}], " ", "+", " ", "5"}], ")"}]}]}], ",", 
               " ", "\"\< [OK]\>\"", ",", " ", "\"\< [WARNING]\>\""}], 
              "]"}]}], "]"}], ";"}]}], "\n", "    ", "]"}], ";", "\n", "\n", 
        "    ", 
        RowBox[{"(*", " ", 
         RowBox[{"Project", " ", "into", " ", "sectors"}], " ", "*)"}], "\n", 
        "    ", 
        RowBox[{"psiE", " ", "=", " ", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "Me", "]"}], " ", ".", " ", 
          "psi0"}]}], ";", "\n", "    ", 
        RowBox[{"psiO", " ", "=", " ", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "Mo", "]"}], " ", ".", " ", 
          "psi0"}]}], ";", "\n", "    ", 
        RowBox[{"ReportPrecision", "[", 
         RowBox[{"\"\<Projected even\>\"", ",", " ", "psiE"}], "]"}], ";", 
        "\n", "    ", 
        RowBox[{"ReportPrecision", "[", 
         RowBox[{"\"\<Projected odd\>\"", ",", " ", "psiO"}], "]"}], ";", 
        "\n", "\n", "    ", 
        RowBox[{"(*", " ", 
         RowBox[{"Norm", " ", "check"}], " ", "*)"}], "\n", "    ", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "nrm", "}"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"nrm", " ", "=", " ", 
            RowBox[{"Re", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Conjugate", "[", "psiE", "]"}], " ", ".", " ", 
               "psiE"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"Conjugate", "[", "psiO", "]"}], " ", ".", " ", 
               "psiO"}]}], "]"}]}], ";", "\n", "      ", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<  Norm (even+odd) = \>\"", ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"nrm", ",", " ", 
               RowBox[{"{", 
                RowBox[{"wp", ",", " ", 
                 RowBox[{"wp", " ", "-", " ", "2"}]}], "}"}]}], "]"}], ",", 
             "\n", "        ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"nrm", " ", "-", " ", "1"}], "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "wp"}], " ", "+", " ", "3"}], ")"}]}]}], ",", 
               " ", "\"\< [OK]\>\"", ",", " ", "\"\< [WARNING]\>\""}], 
              "]"}]}], "]"}], ";"}]}], "\n", "    ", "]"}], ";", "\n", "\n", 
        "    ", 
        RowBox[{"(*", " ", 
         RowBox[{"Overlap", " ", "coefficients", " ", 
          RowBox[{"(", 
           RowBox[{"computed", " ", "once"}], ")"}]}], " ", "*)"}], "\n", 
        "    ", 
        RowBox[{"ckE", " ", "=", " ", 
         RowBox[{"ComputeOverlapsHP", "[", 
          RowBox[{
           RowBox[{"setup", "[", "\"\<eVecs\>\"", "]"}], ",", " ", "psiE"}], 
          "]"}]}], ";", "\n", "    ", 
        RowBox[{"ckO", " ", "=", " ", 
         RowBox[{"ComputeOverlapsHP", "[", 
          RowBox[{
           RowBox[{"setup", "[", "\"\<oVecs\>\"", "]"}], ",", " ", "psiO"}], 
          "]"}]}], ";", "\n", "    ", 
        RowBox[{"ReportPrecision", "[", 
         RowBox[{"\"\<ckE\>\"", ",", " ", "ckE"}], "]"}], ";", "\n", "    ", 
        RowBox[{"ReportPrecision", "[", 
         RowBox[{"\"\<ckO\>\"", ",", " ", "ckO"}], "]"}], ";", "\n", "\n", 
        "    ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"--", 
            RowBox[{"-", " ", "Parallel"}]}], " ", "time", " ", 
           RowBox[{"evolution", " ", "--"}]}], "-"}], " ", "*)"}], "\n", 
        "    ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Chunk", " ", "the", " ", "time", " ", "list", " ", "for", " ", 
          "parallel", " ", "dispatch"}], " ", "*)"}], "\n", "    ", 
        RowBox[{"Nt", " ", "=", " ", 
         RowBox[{"Length", "[", "ttlist", "]"}]}], ";", "\n", "    ", 
        RowBox[{"cSize", " ", "=", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{"Ceiling", "[", 
            RowBox[{"Nt", " ", "/", " ", 
             RowBox[{"Length", "[", 
              RowBox[{"Kernels", "[", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
        "\n", "    ", 
        RowBox[{"chunkRanges", " ", "=", " ", 
         RowBox[{"Partition", "[", 
          RowBox[{
           RowBox[{"Range", "[", "Nt", "]"}], ",", " ", 
           RowBox[{"UpTo", "[", "cSize", "]"}]}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"nChunks", " ", "=", " ", 
         RowBox[{"Length", "[", "chunkRanges", "]"}]}], ";", "\n", "    ", 
        RowBox[{"Print", "[", 
