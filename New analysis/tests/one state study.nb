Cell[CellGroupData[{

Cell["Full entropy evolution", "Title",
 CellChangeTimes->{{3.998128955084362*^9, 
  3.998128957665634*^9}},ExpressionUUID->"f273a5a1-15e1-1c46-b77a-\
61ed46f16c2d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "sortedEigensystem", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sortedEigensystem", "[", "M_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"evals", ",", "evecs", ",", "ord"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"evals", ",", "evecs"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"Normal", "[", "M", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ord", "=", 
       RowBox[{"Ordering", "[", "evals", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"evals", "[", 
         RowBox[{"[", "ord", "]"}], "]"}], ",", 
        RowBox[{"evecs", "[", 
         RowBox[{"[", "ord", "]"}], "]"}]}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9981282300603848`*^9, 3.99812823505954*^9}},
 CellLabel->
  "In[655]:=",ExpressionUUID->"17eacbf1-8210-fd4a-940e-07249e3e79bb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"J", "=", "1."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hz", "=", "1"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9981292825084286`*^9, 3.9981292842807655`*^9}, {
  3.9981293222431755`*^9, 3.9981293781872253`*^9}, {3.998129423332861*^9, 
  3.9981294666784706`*^9}, {3.9981295169203053`*^9, 3.998129523762451*^9}, {
  3.998129647604164*^9, 3.998129667948368*^9}, {3.9981297554909496`*^9, 
  3.9981297615255737`*^9}},ExpressionUUID->"df669555-d812-914c-80f9-\
cb2df9016d70"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hx", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"IsingHamiltonian", "[", 
    RowBox[{"hx", ",", "hz", ",", "J", ",", "L"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9981289649944286`*^9, 3.9981289871910496`*^9}, {
  3.998129221378256*^9, 3.998129237932684*^9}, {3.9981297637927513`*^9, 
  3.9981297643053055`*^9}, {3.9981297964177113`*^9, 3.9981297964819775`*^9}},
 CellLabel->
  "In[694]:=",ExpressionUUID->"287ae0d1-5573-0243-8a4d-8a42b7afc75a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Hp", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{
     RowBox[{"ConjugateTranspose", "[", "Bp", "]"}], ".", "H", ".", "Bp"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hm", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{
     RowBox[{"ConjugateTranspose", "[", "Bm", "]"}], ".", "H", ".", "Bm"}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[696]:=",ExpressionUUID->"d3cfc034-53a0-3045-bc3a-04a5a0e39778"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evalsP", ",", "evecsP"}], "}"}], "=", 
   RowBox[{"sortedEigensystem", "[", "Hp", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evalsM", ",", "evecsM"}], "}"}], "=", 
   RowBox[{"sortedEigensystem", "[", "Hm", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[698]:=",ExpressionUUID->"c36ce91d-009d-fb41-a33f-92f25a10f42a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"psi0", "=", 
   RowBox[{"RandomChainProductState", "[", "L", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9981289880599346`*^9, 3.9981289880599346`*^9}},
 CellLabel->
  "In[670]:=",ExpressionUUID->"8140f0ee-edfa-a94b-bac4-246115aec890"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"psi0P", "=", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "Bp", "]"}], ".", "psi0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"psi0M", "=", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "Bm", "]"}], ".", "psi0"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.998128993477562*^9, 3.998128993477562*^9}},
 CellLabel->
  "In[671]:=",ExpressionUUID->"39c8ed79-d98b-d74c-8821-c58a3229dfd0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Norm", "[", "psi0P", "]"}], "^", "2"}], "+", 
  RowBox[{
   RowBox[{"Norm", "[", "psi0M", "]"}], "^", "2"}]}]], "Input",
 CellChangeTimes->{{3.998129041528517*^9, 3.998129041528517*^9}},
 CellLabel->
  "In[634]:=",ExpressionUUID->"9fc8aa98-d273-2c46-b0ef-5ace172cb845"],

