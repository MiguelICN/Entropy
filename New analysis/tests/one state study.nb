Cell[CellGroupData[{

Cell["Reflection operator", "Title",
 CellChangeTimes->{{3.9981279691726723`*^9, 
  3.998127971677431*^9}},ExpressionUUID->"4542cd4b-577e-9148-b519-\
67610cded1b7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "reflectionOperator", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"reflectionOperator", "[", "L_Integer", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dim", ",", "perm"}], "}"}], ",", 
     RowBox[{
      RowBox[{"dim", "=", 
       RowBox[{"2", "^", "L"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"perm", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"1", "+", 
          RowBox[{"FromDigits", "[", 
           RowBox[{
            RowBox[{"Reverse", "[", 
             RowBox[{"IntegerDigits", "[", 
              RowBox[{
               RowBox[{"j", "-", "1"}], ",", "2", ",", "L"}], "]"}], "]"}], ",",
             "2"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "dim"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", "->", "1"}], ")"}], "&"}], "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"perm", ",", 
            RowBox[{"Range", "[", "dim", "]"}]}], "}"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"dim", ",", "dim"}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9981279723854046`*^9, 3.9981279785051517`*^9}},
 CellLabel->
  "In[584]:=",ExpressionUUID->"7a94ea59-13c9-524e-93cc-c96e92b647b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "reflectionSectorBases", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"reflectionSectorBases", "[", "L_Integer", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dim", ",", "perm", ",", 
       RowBox[{"plusRules", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"minusRules", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"np", "=", "0"}], ",", 
       RowBox[{"nm", "=", "0"}], ",", "j", ",", "k"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dim", "=", 
       RowBox[{"2", "^", "L"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"perm", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"1", "+", 
          RowBox[{"FromDigits", "[", 
           RowBox[{
            RowBox[{"Reverse", "[", 
             RowBox[{"IntegerDigits", "[", 
              RowBox[{
               RowBox[{"j", "-", "1"}], ",", "2", ",", "L"}], "]"}], "]"}], ",",
             "2"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "dim"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "=", 
          RowBox[{"perm", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"j", "<", "k"}], ",", 
           RowBox[{
            RowBox[{"np", "++"}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"plusRules", ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"j", ",", "np"}], "}"}], "->", 
               RowBox[{"1", "/", 
                RowBox[{"Sqrt", "[", "2", "]"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"plusRules", ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", "np"}], "}"}], "->", 
               RowBox[{"1", "/", 
                RowBox[{"Sqrt", "[", "2", "]"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"nm", "++"}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"minusRules", ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"j", ",", "nm"}], "}"}], "->", 
               RowBox[{"1", "/", 
                RowBox[{"Sqrt", "[", "2", "]"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"minusRules", ",", 
