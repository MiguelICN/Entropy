Cell["Entanglement entropy", "Title",
 CellChangeTimes->{{3.998126512300768*^9, 
  3.9981265153789043`*^9}},ExpressionUUID->"62f37f50-dc59-ca44-bb1f-\
62aaa5d08272"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "pageEntropy", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pageEntropy", "[", 
   RowBox[{"La_", ",", "Lb_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"PolyGamma", "[", 
    RowBox[{"0", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "^", "La"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"2", "^", "Lb"}], ")"}]}], "+", "1"}]}], "]"}], "-", 
   RowBox[{"PolyGamma", "[", 
    RowBox[{"0", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "^", "Lb"}], ")"}], "+", "1"}]}], "]"}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "^", "La"}], ")"}], "-", "1"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"2", "^", "Lb"}], ")"}]}], ")"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.998127462276886*^9, 3.998127464974184*^9}},
 CellLabel->
  "In[114]:=",ExpressionUUID->"5d66be5d-e10c-b844-b1ab-4bcc3f167e10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "entanglement", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"entanglement", "[", 
    RowBox[{"psi_", ",", " ", "LA_", ",", " ", "L_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mat", ",", " ", "s", ",", " ", "p"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"mat", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"psi", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "^", "LA"}], ",", " ", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"L", " ", "-", " ", "LA"}], ")"}]}]}], "}"}]}], "]"}]}], 
      ";", "\n", "    ", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"SingularValueList", "[", "mat", "]"}]}], ";", "\n", "    ", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"s", "^", "2"}]}], ";", "\n", "    ", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{
          RowBox[{"#", " ", ">", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "14"}]}]}], " ", "&"}]}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"-", 
       RowBox[{"Chop", "[", 
        RowBox[{"Total", "[", 
         RowBox[{"p", " ", 
          RowBox[{"Log", "[", "p", "]"}]}], "]"}], "]"}]}]}]}], "\n", "]"}]}],
   ";"}]}], "Input",
 CellChangeTimes->{{3.9981268599543896`*^9, 3.9981269023287354`*^9}, {
  3.998126958393795*^9, 3.9981269609487476`*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"2f689b49-f496-6f4a-a595-7495ec6b8473"],

