Cell[BoxData[
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"psi", "=", 
         RowBox[{
          RowBox[{"Transpose", "[", "evecs", "]"}], ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "evals", " ", "t"}], "]"}], " ", 
            "coeff"}], ")"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
