}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coeffP", "=", 
   RowBox[{
    RowBox[{"Conjugate", "[", "evecsP", "]"}], ".", "psi0P"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"coeffM", "=", 
   RowBox[{
    RowBox[{"Conjugate", "[", "evecsM", "]"}], ".", "psi0M"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9981290559053154`*^9, 3.9981290559053154`*^9}},
 CellLabel->
  "In[700]:=",ExpressionUUID->"1faa0de5-e859-2b4e-8340-be4ffad4b14c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "psit", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"psit", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Bp", ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Transpose", "[", "evecsP", "]"}], ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "evalsP", " ", "t"}], "]"}], " ", 
         "coeffP"}], ")"}]}], ")"}]}], "+", 
    RowBox[{"Bm", ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Transpose", "[", "evecsM", "]"}], ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "evalsM", " ", "t"}], "]"}], " ", 
         "coeffM"}], ")"}]}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9981290620171947`*^9, 3.9981290928074627`*^9}, 
   3.998129388268532*^9},
 CellLabel->
  "In[702]:=",ExpressionUUID->"5cf4a719-a589-d84b-8487-cc54e680b294"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tlist", "=", 
   RowBox[{"Table", "[", 
