    RowBox[{"Transpose", "[", "evecs", "]"}], ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "evals", " ", "t"}], "]"}], " ", "coeff"}], 
