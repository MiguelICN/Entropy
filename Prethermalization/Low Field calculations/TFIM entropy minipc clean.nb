    RowBox[{"===", "===", "===", "===", "===", "===", "===", "===", "==="}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Low", "-", 
       RowBox[{"field", " ", "module", " ", 
        RowBox[{"(", "independent", ")"}]}]}], "===", "===", "===", "===", "===",
       "===", "===", "===", "==="}], "="}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "MakeTimeScalePlotsLowField", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"MakeTimeScalePlotsLowField", "[", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "baseDir", ",", "datFiles", ",", "ensureDirLocal", ",", "datPath", ",",
          "data", ",", "meta", ",", "gVal", ",", "xRange", ",", "Lstr", ",", 
         "plot1", ",", "outDir", ",", "outPath", ",", "outName", ",", 
         "gExp"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"baseDir", "=", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"projectDir", ",", "\"\<Data\>\""}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ensureDirLocal", "[", "dir_", "]"}], ":=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", 
           RowBox[{"CreateDirectory", "[", 
            RowBox[{"dir", ",", 
             RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"datFiles", "=", 
         RowBox[{"FileNames", "[", 
          RowBox[{"\"\<TimeScale_*_LowField.dat\>\"", ",", 
           RowBox[{"{", "baseDir", "}"}], ",", "Infinity"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"datFiles", "===", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<No TimeScale_*_LowField.dat files found under: \>\"",
              ",", "baseDir"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "FIXED", " ", "horizontal", " ", "axis", " ", "range", " ", "for", " ",
           "ALL", " ", "LowField", " ", "plots"}], "*)"}], 
        RowBox[{"xRange", "=", 
         RowBox[{"fixedPlotRanges", "[", "\"\<LowField\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Scan", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", "file", "}"}], ",", 
            RowBox[{
             RowBox[{"datPath", "=", "file"}], ";", "\[IndentingNewLine]", 
             RowBox[{"data", "=", 
              RowBox[{"Import", "[", 
               RowBox[{"datPath", ",", "\"\<Table\>\""}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"data", "=", 
              RowBox[{"Select", "[", 
               RowBox[{"data", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"MatchQ", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"_", "?", "NumericQ"}], ",", 
                    RowBox[{"_", "?", "NumericQ"}]}], "}"}]}], "]"}], "&&", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&&", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ">", "0"}]}], "&"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"NEW", ":", 
               RowBox[{
                RowBox[{"enforce", " ", "same", " ", "data", " ", "x"}], "-", 
                
                RowBox[{"range", " ", "for", " ", "all", " ", "plots"}]}]}], 
              "*)"}], 
             RowBox[{"data", "=", 
              RowBox[{"Select", "[", 
               RowBox[{"data", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"xRange", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "<=", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "<=", 
                  RowBox[{"xRange", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"data", "===", 
                RowBox[{"{", "}"}]}], ",", 
               RowBox[{
                RowBox[{"Print", "[", 
                 
                 RowBox[{"\"\<(LowField) Skipping empty/invalid (or \
out-of-range) data: \>\"", ",", "datPath"}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"meta", "=", 
              RowBox[{"timeScaleMeta", "[", "datPath", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"gVal", "=", 
              RowBox[{"meta", "[", "\"\<gVal\>\"", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Lstr", "=", 
              RowBox[{"meta", "[", "\"\<Lstr\>\"", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
                RowBox[{"--", 
                 RowBox[{"-", "plot"}]}], " ", "settings", " ", 
                RowBox[{"unchanged", "--"}]}], "-"}], "*)"}], 
             RowBox[{"plot1", "=", 
              RowBox[{"ListLogLogPlot", "[", 
               RowBox[{"data", ",", 
                RowBox[{"PlotRange", "->", "All"}], ",", 
                RowBox[{"GridLines", "->", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", "gVal", "}"}], ",", "None"}], "}"}]}], ",", 
                RowBox[{"GridLinesStyle", "->", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Directive", "[", 
                    RowBox[{"Red", ",", "Thick"}], "]"}], ",", "None"}], 
                  "}"}]}], ",", 
                RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
                RowBox[{"PlotRange", "->", 
                 RowBox[{"{", 
                  RowBox[{"xRange", ",", "All"}], "}"}]}], ",", 
                RowBox[{"Frame", "->", "True"}], ",", 
                RowBox[{"FrameStyle", "->", 
                 RowBox[{"Directive", "[", 
                  RowBox[{"Black", ",", "24"}], "]"}]}], ",", 
                RowBox[{"ImageSize", "->", "1000"}], ",", 
                RowBox[{"FrameLabel", "->", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Style", "[", 
                    RowBox[{"\"\<h\>\"", ",", "28"}], "]"}], ",", 
                   RowBox[{"Style", "[", 
                    
                    RowBox[{"\"\<Melting Time (\\!\\(\\*SubscriptBox[\\(T\\), \
\\(M\\)]\\))\>\"", ",", "28"}], "]"}]}], "}"}]}], ",", 
                RowBox[{"PlotLabel", "->", 
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"\"\<L = \>\"", "<>", 
                    RowBox[{"ToString", "[", "Lstr", "]"}], 
                    "<>", "\"\<, J = 1, g = \>\"", "<>", 
                    RowBox[{"ToString", "[", "gVal", "]"}]}], ",", "25", ",", 
                   "Black"}], "]"}]}], ",", 
                RowBox[{"PlotStyle", "->", 
                 RowBox[{"Directive", "[", "Black", "]"}]}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"outDir", "=", 
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"DirectoryName", "[", "datPath", "]"}], 
                 ",", "\"\<Plots\>\"", ",", "\"\<LowField\>\""}], "}"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"ensureDirLocal", "[", "outDir", "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"outName", "=", 
              RowBox[{
               RowBox[{"FileBaseName", "[", "datPath", "]"}], 
               "<>", "\"\<.png\>\""}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"outPath", "=", 
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"outDir", ",", "outName"}], "}"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Export", "[", 
              RowBox[{"outPath", ",", "plot1"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<(LowField) Saved: \>\"", ",", "outPath"}], "]"}], 
             ";"}]}], "]"}], ",", "datFiles"}], "]"}], ";", 
        "\[IndentingNewLine]", "True"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Section", "::"}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"4", ")"}], " ", 
     RowBox[{"Plotting", ":", 
