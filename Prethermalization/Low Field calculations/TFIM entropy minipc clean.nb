    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"visited", ",", "evenMap", ",", "oddMap", ",", "j"}], "}"}], ",", 
      RowBox[{
       RowBox[{"visited", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"False", ",", 
          RowBox[{"2", "^", "L"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"evenMap", "=", 
        RowBox[{"{", "}"}]}], ";", 
       RowBox[{"oddMap", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"visited", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"j", "=", 
             RowBox[{"revIndex", "[", 
              RowBox[{"i", ",", "L"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"visited", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", "True"}], ";", 
