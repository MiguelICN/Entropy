   RowBox[{
    RowBox[{"fixedPlotRanges", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<LowField\>\"", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"-", "8"}]}], ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "1"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<HighField\>\"", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"-", "1"}]}], ",", 
          RowBox[{"10", "^", "0.5"}]}], "}"}]}]}], "|>"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "metadata"}]}], " ", "parser", " ", "from", " ", 
      RowBox[{"filename", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"timeScaleMeta", "[", "datPath_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "base", ",", "rangeName", ",", "gExpStr", ",", "gExp", ",", "gVal", ",",
          "Lstr"}], "}"}], ",", 
       RowBox[{
        RowBox[{"base", "=", 
         RowBox[{"FileBaseName", "[", "datPath", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rangeName", "=", 
         RowBox[{"Last", "@", 
          RowBox[{"StringSplit", "[", 
           RowBox[{"base", ",", "\"\<_\>\""}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gExpStr", "=", 
         RowBox[{"First", "@", 
          RowBox[{"StringCases", "[", 
           RowBox[{"base", ",", 
            RowBox[{
             RowBox[{"\"\<g\>\"", "~~", 
              RowBox[{"x", ":", 
               RowBox[{"Shortest", "[", "__", "]"}]}], "~~", "\"\<_\>\""}], ":>",
              "x"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gExp", "=", 
         RowBox[{"ToExpression", "[", "gExpStr", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gVal", "=", 
         RowBox[{"10.", "^", "gExp"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Lstr", "=", 
         RowBox[{"First", "@", 
          RowBox[{"StringCases", "[", 
           RowBox[{"base", ",", 
            RowBox[{
             RowBox[{"\"\<L\>\"", "~~", 
              RowBox[{"x", ":", 
               RowBox[{"DigitCharacter", ".."}]}]}], ":>", "x"}]}], "]"}]}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Base\>\"", "->", "base"}], ",", 
          RowBox[{"\"\<RangeName\>\"", "->", "rangeName"}], ",", 
          RowBox[{"\"\<gExpStr\>\"", "->", "gExpStr"}], ",", 
