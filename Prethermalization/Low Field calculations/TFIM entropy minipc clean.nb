Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1", ")"}], " ", 
    RowBox[{"Calculations", ":", 
     RowBox[{"generate", " ", "Entropy_", "*", 
      RowBox[{".", "mx"}], " ", "files"}]}]}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"simulateEntropy", "[", "L_Integer", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "dataDir", ",", "ini", ",", "evenMap", ",", "oddMap", ",", "psitb", ",",
         "N", ",", "gExp", ",", "gVal", ",", "rangeName", ",", "hList", ",", 
        "hVal", ",", "Ha", ",", "system", ",", "evenvals", ",", "evenvecs", ",",
         "oddvals", ",", "oddvecs", ",", "neweven", ",", "newodd", ",", 
        "allvals", ",", "allvecs", ",", "sortedSystem", ",", "vals", ",", 
        "vecs", ",", "ck", ",", "phaseTable", ",", "tCoeffs", ",", 
        "finalState", ",", "entropySeries", ",", "batchResults", ",", 
        "exportPath", ",", "exportAssoc"}], "}"}], ",", 
      RowBox[{
       RowBox[{"dataDir", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"projectDir", ",", "\"\<Data\>\"", ",", 
           RowBox[{"\"\<L\>\"", "<>", 
            RowBox[{"ToString", "[", "L", "]"}]}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ensureDir", "[", "dataDir", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"\"\<\\nStarting computation for L = \>\"", "<>", 
           RowBox[{"ToString", "[", "L", "]"}]}], ",", "Bold", ",", "Blue", ",",
           "18"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"ini", "=", 
        RowBox[{"RandomChainProductState", "[", "L", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"evenMap", ",", "oddMap"}], "}"}], "=", 
        RowBox[{"getParityMaps", "[", "L", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"compile", " ", "once"}], "*)"}], 
       RowBox[{"psitb", "=", 
        RowBox[{"Compile", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ck", ",", "_Complex", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"phases", ",", "_Complex", ",", "2"}], "}"}]}], "}"}], ",", 
          RowBox[{"ck", "*", "phases"}], ",", 
          RowBox[{"CompilationTarget", "->", "\"\<WVM\>\""}], ",", 
          RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"N", "=", 
        RowBox[{"2", "^", "L"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gVal", "=", 
           RowBox[{"10.", "^", "gExp"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<  Running g = 10^\>\"", "<>", 
              RowBox[{"ToString", "[", 
               RowBox[{"NumberForm", "[", 
                RowBox[{"gExp", ",", 
                 RowBox[{"{", 
                  RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "]"}]}], ",", 
             RowBox[{"Darker", "[", "Green", "]"}], ",", "14"}], "]"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"rangeName", "=", 
              RowBox[{"hSet", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"hList", "=", 
              RowBox[{"hSet", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              
              RowBox[{"\"\<    Processing \>\"", ",", "rangeName", 
               ",", "\"\< (\>\"", ",", 
               RowBox[{"Length", "[", "hList", "]"}], 
               ",", "\"\< values)...\>\""}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"batchResults", "=", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"hVal", "=", "h"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Ha", "=", 
                  RowBox[{"IsingHamiltonian", "[", 
                   RowBox[{"gVal", ",", "hVal", ",", "J", ",", "L", ",", 
                    RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], 
                   "]"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"system", "=", 
                  RowBox[{"BlockDiagonalize", "[", 
                   RowBox[{"Ha", ",", 
                    RowBox[{"Symmetry", "->", "\"\<Parity\>\""}]}], "]"}]}], ";",
                  "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"evenvals", ",", "evenvecs"}], "}"}], "=", 
                  RowBox[{"Transpose", "@", 
                   RowBox[{"Sort", "@", 
                    RowBox[{"Transpose", "@", 
                    RowBox[{"Quiet", "[", 
                    RowBox[{"Eigensystem", "[", 
                    RowBox[{"system", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}]}]}]}], ";",
                  "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"oddvals", ",", "oddvecs"}], "}"}], "=", 
                  RowBox[{"Transpose", "@", 
                   RowBox[{"Sort", "@", 
                    RowBox[{"Transpose", "@", 
                    RowBox[{"Quiet", "[", 
                    RowBox[{"Eigensystem", "[", 
                    RowBox[{"system", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}]}]}]}], ";",
                  "\[IndentingNewLine]", 
                 RowBox[{"neweven", "=", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"ExpandBlockVector", "[", 
                    RowBox[{
                    "v", ",", "evenMap", ",", "\"\<even\>\"", ",", "L"}], 
                    "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"v", ",", "evenvecs"}], "}"}]}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"newodd", "=", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"ExpandBlockVector", "[", 
                    RowBox[{
                    "v", ",", "oddMap", ",", "\"\<odd\>\"", ",", "L"}], "]"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"v", ",", "oddvecs"}], "}"}]}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"allvals", "=", 
                  RowBox[{"Join", "[", 
                   RowBox[{"evenvals", ",", "oddvals"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"allvecs", "=", 
                  RowBox[{"Join", "[", 
                   RowBox[{"neweven", ",", "newodd"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"sortedSystem", "=", 
                  RowBox[{"SortBy", "[", 
                   RowBox[{
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{"allvals", ",", "allvecs"}], "}"}], "]"}], ",", 
                    "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"vals", "=", 
                  RowBox[{"sortedSystem", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"vecs", "=", 
                  RowBox[{"sortedSystem", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"ck", "=", 
                  RowBox[{
                   RowBox[{"Conjugate", "[", "vecs", "]"}], ".", "ini"}]}], ";",
                  "\[IndentingNewLine]", 
                 RowBox[{"phaseTable", "=", 
                  RowBox[{"Exp", "[", 
                   RowBox[{
                    RowBox[{"-", "I"}], " ", 
                    RowBox[{"Outer", "[", 
                    RowBox[{"Times", ",", "vals", ",", "tlist"}], "]"}]}], 
                   "]"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"tCoeffs", "=", 
                  RowBox[{"psitb", "[", 
                   RowBox[{
                    RowBox[{"Developer`ToPackedArray", "[", "ck", "]"}], ",", 
                    
                    RowBox[{
                    "Developer`ToPackedArray", "[", "phaseTable", "]"}]}], 
                   "]"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"finalState", "=", 
                  RowBox[{
                   RowBox[{"Transpose", "[", "vecs", "]"}], ".", 
                   "tCoeffs"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"entropySeries", "=", 
                  RowBox[{"ParallelMap", "[", 
                   RowBox[{"newb", ",", 
                    RowBox[{"Transpose", "[", "finalState", "]"}]}], "]"}]}], 
                 ";", "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{"hVal", ",", "entropySeries"}], "}"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"h", ",", "hList"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"exportPath", "=", 
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"dataDir", ",", 
                 RowBox[{
                  RowBox[{"entropyFileBase", "[", 
                   RowBox[{"L", ",", "gExp", ",", "rangeName"}], "]"}], 
                  "<>", "\"\<.mx\>\""}]}], "}"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"exportAssoc", "=", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<L\>\"", "->", "L"}], ",", 
                RowBox[{"\"\<J\>\"", "->", "J"}], ",", 
                RowBox[{"\"\<g\>\"", "->", "gVal"}], ",", 
                RowBox[{"\"\<h_range_name\>\"", "->", "rangeName"}], ",", 
                RowBox[{"\"\<tlist\>\"", "->", "tlist"}], ",", 
                RowBox[{"\"\<h_values\>\"", "->", "hList"}], ",", 
                RowBox[{"\"\<initial_state\>\"", "->", "ini"}], ",", 
                RowBox[{"\"\<data\>\"", "->", "batchResults"}]}], "|>"}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"Export", "[", 
              RowBox[{"exportPath", ",", "exportAssoc"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<    Saved: \>\"", ",", 
               RowBox[{"FileNameTake", "[", "exportPath", "]"}]}], "]"}], ";",
              "\[IndentingNewLine]", 
