Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"3", ")"}], " ", 
     RowBox[{"Processing", ":", 
      RowBox[{"extract", " ", "crossing", " ", "times"}]}]}], "->", 
    RowBox[{"TimeScale_", "*", 
     RowBox[{".", "dat"}], " ", 
     RowBox[{"(", 
      RowBox[{"one", " ", "per", " ", "Entropy_", "*", 
       RowBox[{".", "mx"}]}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "ExtractCrossingTime", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ExtractCrossingTime", "[", 
      RowBox[{"timeList_", ",", "entropy_", ",", 
       RowBox[{"window_", ":", "200"}], ",", 
       RowBox[{"threshold_", ":", 
        RowBox[{"N", "@", 
         RowBox[{"Log", "[", "2", "]"}]}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "sClean", ",", "smoothS", ",", "smoothT", ",", "crossPos", ",", "k", ",",
          "t1", ",", "t2", ",", "s1", ",", "s2"}], "}"}], ",", 
       RowBox[{
        RowBox[{"sClean", "=", 
         RowBox[{"Re", "@", 
          RowBox[{"Flatten", "@", "entropy"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "timeList", "]"}], "=!=", 
           RowBox[{"Length", "[", "sClean", "]"}]}], ",", 
          RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"smoothS", "=", 
         RowBox[{"MovingAverage", "[", 
          RowBox[{"sClean", ",", "window"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"smoothT", "=", 
         RowBox[{"MovingAverage", "[", 
          RowBox[{"timeList", ",", "window"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"crossPos", "=", 
         RowBox[{"FirstPosition", "[", 
          RowBox[{"smoothS", ",", 
           RowBox[{"_", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", ">=", "threshold"}], "&"}], ")"}]}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MissingQ", "[", "crossPos", "]"}], ",", 
          RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"k", "=", 
         RowBox[{"crossPos", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"k", "==", "1"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"smoothT", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"t1", "=", 
         RowBox[{"smoothT", "[", 
          RowBox[{"[", 
           RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ";", 
        RowBox[{"t2", "=", 
         RowBox[{"smoothT", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"s1", "=", 
         RowBox[{"smoothS", "[", 
          RowBox[{"[", 
           RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ";", 
        RowBox[{"s2", "=", 
         RowBox[{"smoothS", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"t1", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t2", "-", "t1"}], ")"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"threshold", "-", "s1"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"s2", "-", "s1"}], ")"}]}]}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "processCrossingTimes", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"processCrossingTimes", "[", "fullPath_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "dataAssoc", ",", "tlistLocal", ",", "curves", ",", "crossingTimes", ",",
          "outBase", ",", "outPath", ",", "thr", ",", "L"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Processing crossings: \>\"", ",", 
          RowBox[{"FileBaseName", "[", "fullPath", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dataAssoc", "=", 
         RowBox[{"Import", "[", "fullPath", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"L", "=", 
         RowBox[{"dataAssoc", "[", "\"\<L\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"thr", "=", 
         RowBox[{"crossingThreshold", "[", "L", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   L = \>\"", ",", "L", ",", "\"\<  threshold = \>\"", ",",
           "thr"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"tlistLocal", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"dataAssoc", "[", "\"\<tlist\>\"", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"curves", "=", 
         RowBox[{"dataAssoc", "[", "\"\<data\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"crossingTimes", "=", 
         RowBox[{
          RowBox[{"Reap", "[", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"hVal", "=", 
                  RowBox[{"curve", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                 RowBox[{"sSeries", "=", 
                  RowBox[{"curve", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"tm", "=", 
                   RowBox[{"ExtractCrossingTime", "[", 
                    RowBox[{
                    "tlistLocal", ",", "sSeries", ",", "crossingWindow", ",", 
                    "thr"}], "]"}]}], "}"}], ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"NumericQ", "[", "tm", "]"}], ",", 
                   RowBox[{"Sow", "[", 
                    RowBox[{"{", 
                    RowBox[{"hVal", ",", "tm"}], "}"}], "]"}]}], "]"}]}], 
                "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"curve", ",", "curves"}], "}"}]}], "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"crossingTimes", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"crossingTimes", "===", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{"{", "}"}], ",", 
           RowBox[{"First", "[", "crossingTimes", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"crossingTimes", "===", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Return", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"outBase", "=", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"FileBaseName", "[", "fullPath", "]"}], ",", 
           RowBox[{
            RowBox[{"StartOfString", "~~", "\"\<Entropy\>\""}], 
            "->", "\"\<TimeScale\>\""}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"outPath", "=", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"DirectoryName", "[", "fullPath", "]"}], ",", 
            RowBox[{"outBase", "<>", "\"\<.dat\>\""}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{"outPath", ",", "crossingTimes", ",", "\"\<Table\>\""}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   -> Saved: \>\"", ",", "outPath"}], "]"}], ";"}]}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.97912012148155*^9, 3.979120121765684*^9}, 
