Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "RunSRN", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RunSRN", "[", 
    RowBox[{
    "cfg_Association", ",", "glist_List", ",", "hlist_List", ",", 
     "baseDir_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"L", "=", 
        RowBox[{"cfg", "[", "\"\<L\>\"", "]"}]}], ",", 
       RowBox[{"J", "=", 
        RowBox[{"cfg", "[", "\"\<J\>\"", "]"}]}], ",", 
       RowBox[{"psi0", "=", 
        RowBox[{"cfg", "[", "\"\<psi0\>\"", "]"}]}], ",", 
       RowBox[{"tlist", "=", 
        RowBox[{"cfg", "[", "\"\<tlist\>\"", "]"}]}], ",", 
       RowBox[{"smooth", "=", 
        RowBox[{"cfg", "[", "\"\<smoothWindow\>\"", "]"}]}], ",", "static", ",",
        "dirs", ",", "dataDir", ",", "figDir", ",", "hvals", ",", "styles", ",",
        "gvals", ",", "kList", ",", "kmax", ",", "g", ",", "matsByH", ",", 
       "curves", ",", "yMax", ",", "pageVal", ",", "baseName", ",", "meta", ",",
        "plot"}], "}"}], ",", 
     RowBox[{
      RowBox[{"static", "=", 
       RowBox[{"BuildStaticLObjects", "[", "L", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dirs", "=", 
       RowBox[{"GetExportDirs", "[", 
        RowBox[{"baseDir", ",", "\"\<SRN\>\"", ",", "L"}], "]"}]}], ";", 
      RowBox[{"dataDir", "=", 
       RowBox[{"dirs", "[", "\"\<dataDir\>\"", "]"}]}], ";", 
      RowBox[{"figDir", "=", 
       RowBox[{"dirs", "[", "\"\<figDir\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hvals", "=", 
       RowBox[{"Sort", "@", 
        RowBox[{"N", "@", "hlist"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"styles", "=", 
       RowBox[{"BlueRedStylesByValue", "[", "hvals", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gvals", "=", 
       RowBox[{"Sort", "@", 
        RowBox[{"N", "@", "glist"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"kmax", "=", 
       RowBox[{"Floor", "[", 
        RowBox[{"L", "/", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"kList", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"cfg", ",", "\"\<kList\>\"", ",", 
         RowBox[{"Range", "[", "kmax", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"matsByH", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"ComputeMeanEntropyMatrixAllK", "[", 
             RowBox[{"psi0", ",", "static", ",", 
              RowBox[{"BuildEvolvers", "[", 
               RowBox[{"L", ",", "J", ",", "g", ",", "h"}], "]"}], ",", 
              "tlist", ",", "L"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"h", ",", "hvals"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"curves", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"MovingAverage", "[", 
                RowBox[{
                 RowBox[{"Transpose", "[", 
                  RowBox[{"{", 
                   RowBox[{"tlist", ",", 
                    RowBox[{
                    RowBox[{"matsByH", "[", 
                    RowBox[{"[", "ih", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "k"}], "]"}], "]"}]}], "}"}], "]"}], ",",
                  "smooth"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"ih", ",", 
                 RowBox[{"Length", "[", "hvals", "]"}]}], "}"}]}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"yMax", "=", 
             RowBox[{"k", " ", 
              RowBox[{"Log", "[", "2", "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"pageVal", "=", 
             RowBox[{"PageEntropyNats", "[", 
              RowBox[{"L", ",", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"baseName", "=", 
             RowBox[{"\"\<SRN_L\>\"", "<>", 
              RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<_g\>\"", "<>", 
              RowBox[{"tagNumber", "[", "g", "]"}], "<>", "\"\<_k\>\"", "<>", 
              RowBox[{"ToString", "[", "k", "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"meta", "=", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<regime\>\"", "->", "\"\<SRN\>\""}], ",", 
               RowBox[{"\"\<L\>\"", "->", "L"}], ",", 
               RowBox[{"\"\<J\>\"", "->", "J"}], ",", 
               RowBox[{"\"\<gFixed\>\"", "->", "g"}], ",", 
               RowBox[{"\"\<hList\>\"", "->", "hvals"}], ",", 
               RowBox[{"\"\<k\>\"", "->", "k"}], ",", 
               RowBox[{"\"\<tlist\>\"", "->", "tlist"}], ",", 
               RowBox[{"\"\<curves\>\"", "->", "curves"}]}], "|>"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"plot", "=", 
             RowBox[{"MakeFamilyPlot", "[", 
              RowBox[{
              "tlist", ",", "curves", ",", "styles", ",", "yMax", ",", 
               "pageVal", ",", 
               RowBox[{"\"\<SRN: L=\>\"", "<>", 
                RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, g=\>\"", "<>", 
                RowBox[{"ToString", "@", "g"}], "<>", "\"\<, k=\>\"", "<>", 
                RowBox[{"ToString", "[", "k", "]"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"ExportRun", "[", 
             RowBox[{
             "dataDir", ",", "figDir", ",", "baseName", ",", "meta", ",", 
              "plot"}], "]"}], ";"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "kList"}], "}"}]}], "]"}], ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"g", ",", "gvals"}], "}"}]}], "]"}], ";"}]}], "]"}]}], 
  ";"}]}], "Input",
