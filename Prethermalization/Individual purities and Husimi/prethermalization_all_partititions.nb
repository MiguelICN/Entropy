Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "PageEntropyNats", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PageEntropyNats", "[", 
    RowBox[{
     RowBox[{"L_Integer", "?", "Positive"}], ",", 
     RowBox[{"k_Integer", "?", "Positive"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "n"}], "}"}], ",", 
     RowBox[{
      RowBox[{"m", "=", 
       RowBox[{"2", "^", 
        RowBox[{"Min", "[", 
         RowBox[{"k", ",", 
          RowBox[{"L", "-", "k"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"2", "^", 
        RowBox[{"Max", "[", 
         RowBox[{"k", ",", 
          RowBox[{"L", "-", "k"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"HarmonicNumber", "[", 
        RowBox[{"m", " ", "n"}], "]"}], "-", 
       RowBox[{"HarmonicNumber", "[", "n", "]"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"m", "-", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "n"}], ")"}]}]}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979203550069948*^9, 3.9792035509327793`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"8a1cf351-6004-9043-ba80-4574986079fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "getEntropyPartitioned", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"getEntropyPartitioned", "[", 
    RowBox[{"stateVec_", ",", 
     RowBox[{"nSys_Integer", "?", "Positive"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tensor", "=", 
        RowBox[{"ArrayReshape", "[", 
         RowBox[{"stateVec", ",", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"2", ",", "nSys"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"kmax", "=", 
        RowBox[{"Floor", "[", 
         RowBox[{"nSys", "/", "2"}], "]"}]}], ",", "entByK", ",", "subs", ",",
        "sub", ",", "perm", ",", "tensorPerm", ",", "mat", ",", "sv", ",", 
       "p", ",", "ppos"}], "}"}], ",", 
     RowBox[{
      RowBox[{"entByK", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", 
         RowBox[{"{", "kmax", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"subs", "=", 
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"Range", "[", "nSys", "]"}], ",", 
            RowBox[{"{", "k", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"entByK", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"perm", "=", 
              RowBox[{"Join", "[", 
               RowBox[{"sub", ",", 
                RowBox[{"Complement", "[", 
                 RowBox[{
                  RowBox[{"Range", "[", "nSys", "]"}], ",", "sub"}], "]"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"tensorPerm", "=", 
              RowBox[{"Transpose", "[", 
               RowBox[{"tensor", ",", "perm"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"mat", "=", 
              RowBox[{"ArrayReshape", "[", 
               RowBox[{"tensorPerm", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"2", "^", "k"}], ",", 
                  RowBox[{"2", "^", 
                   RowBox[{"(", 
                    RowBox[{"nSys", "-", "k"}], ")"}]}]}], "}"}]}], "]"}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"sv", "=", 
              RowBox[{"SingularValueList", "[", "mat", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"p", "=", 
              RowBox[{"Clip", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Chop", "[", "sv", "]"}], "^", "2"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"p", "=", 
              RowBox[{"p", "/", 
               RowBox[{"Total", "[", "p", "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"ppos", "=", 
              RowBox[{"Select", "[", 
               RowBox[{"p", ",", 
                RowBox[{
                 RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"-", 
              RowBox[{"Total", "[", 
               RowBox[{"ppos", " ", 
                RowBox[{"Log", "[", "ppos", "]"}]}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"sub", ",", "subs"}], "}"}]}], "]"}]}], ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "kmax"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "entByK"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "MeanEntropiesAllK", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MeanEntropiesAllK", "[", 
    RowBox[{"stateVec_", ",", 
     RowBox[{"L_Integer", "?", "Positive"}]}], "]"}], ":=", 
   RowBox[{"Mean", "/@", 
    RowBox[{"getEntropyPartitioned", "[", 
     RowBox[{"stateVec", ",", "L"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DistributeDefinitions", "[", 
   RowBox[{"getEntropyPartitioned", ",", "MeanEntropiesAllK"}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.979203533398529*^9, 3.9792035441924324`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"72f93b0a-cfae-9245-b80f-a68f951d8f9a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "BuildStaticLObjects", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BuildStaticLObjects", "[", 
     RowBox[{"L_Integer", "?", "Positive"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"evenMap", ",", "oddMap", ",", "expand"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"evenMap", ",", "oddMap"}], "}"}], "=", 
        RowBox[{"buildMaps", "[", "L", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"expand", "=", 
        RowBox[{"buildExpandFullStateFast", "[", 
         RowBox[{"evenMap", ",", "oddMap", ",", "L"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<evenMap\>\"", "->", "evenMap"}], ",", 
         RowBox[{"\"\<oddMap\>\"", "->", "oddMap"}], ",", 
         RowBox[{"\"\<Expand\>\"", "->", "expand"}]}], "|>"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "BuildEvolvers", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BuildEvolvers", "[", 
     RowBox[{
      RowBox[{"L_Integer", "?", "Positive"}], ",", 
      RowBox[{"J_", "?", "NumericQ"}], ",", 
      RowBox[{"g_", "?", "NumericQ"}], ",", 
      RowBox[{"h_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "Ha", ",", "system", ",", "evenEigvals", ",", "evenEigvecs", ",", 
        "oddEigvals", ",", "oddEigvecs"}], "}"}], ",", 
      RowBox[{
       RowBox[{"Ha", "=", 
        RowBox[{"IsingHamiltonian", "[", 
         RowBox[{"h", ",", "g", ",", "J", ",", "L", ",", 
          RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"system", "=", 
        RowBox[{"BlockDiagonalize", "[", 
         RowBox[{"Ha", ",", 
          RowBox[{"Symmetry", "->", "\"\<Parity\>\""}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"evenEigvals", ",", "evenEigvecs"}], "}"}], "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Sort", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"Quiet", "[", 
            RowBox[{"Eigensystem", "[", 
             RowBox[{"system", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"oddEigvals", ",", "oddEigvecs"}], "}"}], "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Sort", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"Quiet", "[", 
            RowBox[{"Eigensystem", "[", 
             RowBox[{"system", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"evenEigvecs", "=", 
        RowBox[{"Developer`ToPackedArray", "[", "evenEigvecs", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"evenEigvals", "=", 
        RowBox[{"Developer`ToPackedArray", "[", "evenEigvals", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"oddEigvecs", "=", 
        RowBox[{"Developer`ToPackedArray", "[", "oddEigvecs", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"oddEigvals", "=", 
        RowBox[{"Developer`ToPackedArray", "[", "oddEigvals", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<evenEvolver\>\"", "->", 
          RowBox[{"compiledEvolverSector", "[", 
           RowBox[{"evenEigvecs", ",", "evenEigvals"}], "]"}]}], ",", 
         RowBox[{"\"\<oddEvolver\>\"", "->", 
          RowBox[{"compiledEvolverSector", "[", 
           RowBox[{"oddEigvecs", ",", "oddEigvals"}], "]"}]}]}], "|>"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "ComputeMeanEntropyMatrixAllK", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ComputeMeanEntropyMatrixAllK", "[", 
    RowBox[{"state_", ",", "static_", ",", "evol_", ",", "tlist_List", ",", 
     RowBox[{"L_Integer", "?", "Positive"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "psiEven", ",", "psiOdd", ",", "evenFinal", ",", "oddFinal", ",", 
       "fullStates"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"psiEven", ",", "psiOdd"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ProjectBlockVector", "[", 
          RowBox[{"state", ",", 
           RowBox[{"static", "[", "\"\<evenMap\>\"", "]"}], 
           ",", "\"\<even\>\"", ",", "L"}], "]"}], ",", 
         RowBox[{"ProjectBlockVector", "[", 
          RowBox[{"state", ",", 
           RowBox[{"static", "[", "\"\<oddMap\>\"", "]"}], ",", "\"\<odd\>\"",
            ",", "L"}], "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"evenFinal", "=", 
       RowBox[{
        RowBox[{"evol", "[", "\"\<evenEvolver\>\"", "]"}], "[", 
        RowBox[{"psiEven", ",", "tlist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"oddFinal", "=", 
       RowBox[{
        RowBox[{"evol", "[", "\"\<oddEvolver\>\"", "]"}], "[", 
        RowBox[{"psiOdd", ",", "tlist"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fullStates", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{"static", "[", "\"\<Expand\>\"", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"evenFinal", ",", "oddFinal"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MeanEntropiesAllK", "[", 
          RowBox[{"#", ",", "L"}], "]"}], "&"}], ",", "fullStates"}], 
       "]"}]}]}], "]"}]}], ";"}]}], "Input",
