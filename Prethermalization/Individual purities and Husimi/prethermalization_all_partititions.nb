 RowBox[{
  RowBox[{
   RowBox[{"GetExportDirs", "[", 
    RowBox[{"baseDir_", ",", "regime_String", ",", 
     RowBox[{"L_Integer", "?", "Positive"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"root", ",", "runDir", ",", "dataDir", ",", "figDir"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"root", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"baseDir", ",", "\"\<exports\>\""}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"runDir", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"root", ",", "regime", ",", 
          RowBox[{"\"\<L\>\"", "<>", 
           RowBox[{"ToString", "[", "L", "]"}]}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dataDir", "=", 
