      "\[IndentingNewLine]", 
      RowBox[{"figDir", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"runDir", ",", "\"\<figures\>\""}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"DirectoryQ", "[", "dataDir", "]"}]}], ",", 
        RowBox[{"CreateDirectory", "[", 
         RowBox[{"dataDir", ",", 
          RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
