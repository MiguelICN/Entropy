Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "RunLRN", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RunLRN", "[", 
    RowBox[{
    "cfg_Association", ",", "hlist_List", ",", "glist_List", ",", 
     "baseDir_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"L", "=", 
        RowBox[{"cfg", "[", "\"\<L\>\"", "]"}]}], ",", 
       RowBox[{"J", "=", 
        RowBox[{"cfg", "[", "\"\<J\>\"", "]"}]}], ",", 
       RowBox[{"psi0", "=", 
        RowBox[{"cfg", "[", "\"\<psi0\>\"", "]"}]}], ",", 
       RowBox[{"tlist", "=", 
        RowBox[{"cfg", "[", "\"\<tlist\>\"", "]"}]}], ",", 
       RowBox[{"smooth", "=", 
        RowBox[{"cfg", "[", "\"\<smoothWindow\>\"", "]"}]}], ",", "static", ",",
        "dirs", ",", "dataDir", ",", "figDir", ",", "gvals", ",", "styles", ",",
        "kList", ",", "kmax", ",", "h", ",", "matsByG", ",", "curves", ",", 
       "yMax", ",", "pageVal", ",", "baseName", ",", "meta", ",", "plot"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"static", "=", 
       RowBox[{"BuildStaticLObjects", "[", "L", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dirs", "=", 
       RowBox[{"GetExportDirs", "[", 
        RowBox[{"baseDir", ",", "\"\<LRN\>\"", ",", "L"}], "]"}]}], ";", 
      RowBox[{"dataDir", "=", 
       RowBox[{"dirs", "[", "\"\<dataDir\>\"", "]"}]}], ";", 
      RowBox[{"figDir", "=", 
       RowBox[{"dirs", "[", "\"\<figDir\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gvals", "=", 
       RowBox[{"Sort", "@", 
        RowBox[{"N", "@", "glist"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"styles", "=", 
       RowBox[{"BlueRedStylesByValue", "[", "gvals", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"kmax", "=", 
       RowBox[{"Floor", "[", 
        RowBox[{"L", "/", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"kList", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"cfg", ",", "\"\<kList\>\"", ",", 
         RowBox[{"Range", "[", "kmax", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"matsByG", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"ComputeMeanEntropyMatrixAllK", "[", 
             RowBox[{"psi0", ",", "static", ",", 
              RowBox[{"BuildEvolvers", "[", 
               RowBox[{"L", ",", "J", ",", "g", ",", "h"}], "]"}], ",", 
              "tlist", ",", "L"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"g", ",", "gvals"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"curves", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"MovingAverage", "[", 
                RowBox[{
                 RowBox[{"Transpose", "[", 
                  RowBox[{"{", 
                   RowBox[{"tlist", ",", 
                    RowBox[{
                    RowBox[{"matsByG", "[", 
                    RowBox[{"[", "ig", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "k"}], "]"}], "]"}]}], "}"}], "]"}], ",",
                  "smooth"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"ig", ",", 
                 RowBox[{"Length", "[", "gvals", "]"}]}], "}"}]}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"yMax", "=", 
             RowBox[{"k", " ", 
              RowBox[{"Log", "[", "2", "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"pageVal", "=", 
             RowBox[{"PageEntropyNats", "[", 
              RowBox[{"L", ",", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"baseName", "=", 
             RowBox[{"\"\<LRN_L\>\"", "<>", 
              RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<_h\>\"", "<>", 
              RowBox[{"tagNumber", "[", "h", "]"}], "<>", "\"\<_k\>\"", "<>", 
              RowBox[{"ToString", "[", "k", "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"meta", "=", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<regime\>\"", "->", "\"\<LRN\>\""}], ",", 
               RowBox[{"\"\<L\>\"", "->", "L"}], ",", 
               RowBox[{"\"\<J\>\"", "->", "J"}], ",", 
               RowBox[{"\"\<hFixed\>\"", "->", "h"}], ",", 
               RowBox[{"\"\<gList\>\"", "->", "gvals"}], ",", 
               RowBox[{"\"\<k\>\"", "->", "k"}], ",", 
