Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "BlueRedStylesByValue", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BlueRedStylesByValue", "[", 
     RowBox[{"paramVals_List", ",", 
      RowBox[{"thickness_", ":", "1.4"}], ",", 
      RowBox[{"opacity_", ":", "0.9"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"vals", "=", 
         RowBox[{"N", "@", "paramVals"}]}], ",", "sorted", ",", "n", ",", 
        "ts", ",", "cols", ",", "colOf"}], "}"}], ",", 
      RowBox[{
       RowBox[{"sorted", "=", 
        RowBox[{"Sort", "[", "vals", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "sorted", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ts", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "==", "1"}], ",", 
          RowBox[{"{", "0.0", "}"}], ",", 
          RowBox[{"Subdivide", "[", 
           RowBox[{"0.0", ",", "1.0", ",", 
            RowBox[{"n", "-", "1"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cols", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Blend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Blue", ",", "Red"}], "}"}], ",", "#"}], "]"}], "&"}], "/@",
          "ts"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"colOf", "=", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{"sorted", "->", "cols"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"Opacity", "[", "opacity", "]"}], ",", 
           RowBox[{"AbsoluteThickness", "[", "thickness", "]"}], ",", 
           RowBox[{"colOf", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
        "vals"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "MakeFamilyPlot", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MakeFamilyPlot", "[", 
     RowBox[{
     "tlist_", ",", "curves_List", ",", "styles_List", ",", "yMax_", ",", 
      "pageVal_", ",", "title_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"tmin", "=", 
         RowBox[{"First", "[", "tlist", "]"}]}], ",", 
        RowBox[{"tmax", "=", 
         RowBox[{"Last", "[", "tlist", "]"}]}]}], "}"}], ",", 
      RowBox[{"Show", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ListLogLinearPlot", "[", 
          RowBox[{"curves", ",", 
           RowBox[{"PlotStyle", "->", "styles"}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<t\>\"", ",", "\"\<mean S_k(t) (nats)\>\""}], 
             "}"}]}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{"0", ",", "yMax"}], "}"}]}], ",", 
           RowBox[{"ImageSize", "->", "1000"}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             RowBox[{"title", ",", "18", ",", "Black"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"LogLinearPlot", "[", 
          RowBox[{"pageVal", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "tmin", ",", "tmax"}], "}"}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", "Dashed"}], "]"}]}]}], "]"}]}], "}"}], 
       "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "tagNumber", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"tagNumber", "[", 
     RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
