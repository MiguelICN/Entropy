Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", "===", "===", 
    RowBox[{"Plot", " ", "styling", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"blue", "->", "red"}], ",", 
       RowBox[{"no", " ", "legends"}]}], ")"}]}], "===", "===", "==="}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "BlueRedStylesByValue", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BlueRedStylesByValue", "[", 
      RowBox[{"paramVals_List", ",", 
       RowBox[{"thickness_", ":", "1.4"}], ",", 
       RowBox[{"opacity_", ":", "0.9"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"vals", "=", 
          RowBox[{"N", "@", "paramVals"}]}], ",", "sorted", ",", "n", ",", 
         "ts", ",", "cols", ",", "colOf"}], "}"}], ",", 
       RowBox[{
        RowBox[{"sorted", "=", 
         RowBox[{"Sort", "[", "vals", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "sorted", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ts", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"n", "==", "1"}], ",", 
           RowBox[{"{", "0.0", "}"}], ",", 
           RowBox[{"Subdivide", "[", 
            RowBox[{"0.0", ",", "1.0", ",", 
             RowBox[{"n", "-", "1"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cols", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Blend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Blue", ",", "Red"}], "}"}], ",", "#"}], "]"}], "&"}], "/@",
           "ts"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"colOf", "=", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{"sorted", "->", "cols"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Opacity", "[", "opacity", "]"}], ",", 
            RowBox[{"AbsoluteThickness", "[", "thickness", "]"}], ",", 
            RowBox[{"colOf", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
         "vals"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
