            RowBox[{"Background", "->", "White"}]}], "]"}], ",", 
          RowBox[{"LogLinearPlot", "[", 
           RowBox[{"pageVal", ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "tmin", ",", "tmax"}], "}"}], ",", 
            RowBox[{"PlotStyle", "->", 
