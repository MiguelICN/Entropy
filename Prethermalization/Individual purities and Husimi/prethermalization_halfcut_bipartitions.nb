            RowBox[{"FrameStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"Black", ",", "20"}], "]"}]}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"tmin", ",", "tmax"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "yMax"}], "}"}]}], "}"}]}], ",", 
            RowBox[{"ImageSize", "->", "1000"}], ",", 
            RowBox[{"PlotLabel", "->", 
             RowBox[{"Style", "[", 
